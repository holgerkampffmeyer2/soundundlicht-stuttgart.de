{
  "name": "soundundlicht-stuttgart",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "build:images": "node scripts/optimize-images.mjs",
    "build:full": "node scripts/lastmod.mjs && astro build && node scripts/generate-rss.mjs && node scripts/update-sitemap.mjs",
    "build:full-with-images": "node scripts/optimize-images.mjs && node scripts/lastmod.mjs && astro build && node scripts/generate-rss.mjs && node scripts/update-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --cache --cache-location .eslintcache",
    "lint:agent": "eslint src --format unix --quiet --cache --cache-location .eslintcache",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --pool=forks",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-rss": "node scripts/generate-rss.mjs",
    "generate-urllist": "node scripts/update-sitemap.mjs",
    "update-reviews": "node scripts/fetch-google-reviews.mjs",
    "gmaps:login": "node scripts/gmaps-login.mjs",
    "indexnow-submit": "node scripts/indexnow-submit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-pagefind": "^2.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}

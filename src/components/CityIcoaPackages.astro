---
import { getCollection } from 'astro:content';
import PackageCardGrid from './PackageCardGrid.astro';

interface Props {
  cityName: string;
  title?: string;
  intro?: string;
  eyebrow?: string;
}

const { cityName, title, intro, eyebrow = 'Leistungsfähige PA' } = Astro.props;
const sectionTitle = title ?? `LD Systems ICOA für ${cityName}`;
const sectionDescription = intro ?? `Meine ICOA-Pakete sind die leistungsfähigste PA in meinem Verleih: klarer Sound, ordentlich Bass und genug Reserven für größere Räume, DJs und Studentenparties in ${cityName}.`;
const slugs = ['ld-icoa-party-paket', 'ld-icoa-club-paket', 'ld-icoa-top-paar'];

const products = await getCollection('products');
const bySlug = new Map(products.map(product => [product.data.slug, product.data]));
const pakete = slugs
  .map(slug => bySlug.get(slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .map(item => ({
    slug: item.slug,
    title: item.shortTitle ?? item.title,
    description: item.description,
    image: item.image,
    price: item.price,
    features: item.features.slice(0, 5),
    detailPage: item.detailPage,
    isNew: item.isNew,
    audienceTag: item.audienceTag,
    audienceDescription: item.audienceDescription,
    personRange: item.personRange,
    setupTime: item.setupTime,
    spotifyReady: item.spotifyReady,
    micIncluded: item.micIncluded,
    lightIncluded: item.lightIncluded,
  }));
---

{pakete.length > 0 && (
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          {eyebrow}
        </span>
        <h2 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-6">
          {sectionTitle}
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-3xl mx-auto">
          {sectionDescription}
        </p>
      </div>

      <PackageCardGrid pakete={pakete} />

      <div class="text-center mt-12 animate-on-scroll">
        <a href="/vermietung/ld-systems-icoa-series" class="btn-secondary inline-block text-base py-3 px-8">
          Alle ICOA-Pakete ansehen ↗
        </a>
      </div>
    </div>
  </section>
)}

---
interface PaketItem {
  slug: string;
  title: string;
  description: string;
  image: string;
  price: string;
  features: string[];
  detailPage?: string;
  audienceTag?: string;
  audienceDescription?: string;
  personRange?: string;
  setupTime?: string;
  spotifyReady?: boolean;
  micIncluded?: boolean;
  lightIncluded?: boolean;
}

interface Props {
  pakete: PaketItem[];
}

const { pakete } = Astro.props;

import { getWebpUrl, getThumbUrl } from '../lib/imageUtils';
import Icon from './Icon.astro';
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-package-grid>
   {pakete.map((item, index) => (
     <div class="card-base equipment-card" style={`animation-delay: ${index * 0.1}s`}>
        <div class="relative">
          <picture>
            <source srcset={`${getThumbUrl(item.image)} 480w, ${getWebpUrl(item.image)} 960w`} type="image/webp" />
            <img src={item.image} alt={item.title} width="400" height="256" loading="lazy" decoding="async" class="rounded-xl w-full h-64 object-cover mb-4 bg-[var(--color-surface)]" />
          </picture>
          <span class="plug-badge">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel & Einweisung
          </span>
          {item.audienceTag && (
            <span class="absolute top-3 left-3 bg-[var(--color-accent)] text-white text-xs font-bold px-3 py-1 rounded-full">
              {item.audienceTag}
            </span>
          )}
        </div>
        <div class="flex items-center gap-1">
          <span class="price-badge">{item.price}</span>
          <span class="price-info-wrap">
            <svg class="price-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
            <span class="price-info-popup">Unverbindliche Preisangabe. Das finale Angebot erhalte ich nach Absenden des Formulars.</span>
          </span>
        </div>
        <h3 class="text-xl font-bold mt-2 mb-1">{item.title}</h3>
        {item.audienceDescription && (
          <p class="text-[var(--color-secondary)] text-sm font-medium mb-2">{item.audienceDescription}</p>
        )}
        <p class="text-[var(--color-text-muted)] text-sm mb-3">{item.description}</p>

        {/* Entscheidungshilfe */}
        <div class="rounded-lg p-3 text-sm border border-[var(--color-border)]">
          <div class="grid grid-cols-2 gap-2">
            {item.personRange && (
              <div class="flex items-center gap-1.5">
                <span class="text-[var(--color-secondary)]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                </span>
                <span class="text-[var(--color-text-muted)]">{item.personRange}</span>
              </div>
            )}
            {item.setupTime && (
              <div class="flex items-center gap-1.5">
                <span class="text-[var(--color-secondary)]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
                <span class="text-[var(--color-text-muted)]">Aufbau: {item.setupTime}</span>
              </div>
            )}
            {item.spotifyReady && (
              <div class="flex items-center gap-1.5">
                <span class="text-[var(--color-secondary)]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z" /></svg>
                </span>
                <span class="text-[var(--color-text-muted)]">Spotify ✓</span>
              </div>
            )}
            {item.micIncluded !== undefined && (
              <div class="flex items-center gap-1.5">
                <span class="text-[var(--color-secondary)]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5m-7.5 0a3 3 0 01-3-3V5.25a3 3 0 013-3h7.5a3 3 0 013 3v10.5a3 3 0 01-3 3h-7.5z" /></svg>
                </span>
                <span class="text-[var(--color-text-muted)]">{item.micIncluded ? 'Mikrofon ✓' : 'Kein Mikrofon'}</span>
              </div>
            )}
            {item.lightIncluded !== undefined && (
              <div class="flex items-center gap-1.5 col-span-2">
                <span class="text-[var(--color-secondary)]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
                </span>
                <span class="text-[var(--color-text-muted)]">{item.lightIncluded ? 'Licht enthalten ✓' : 'Nur Sound'}</span>
              </div>
            )}
          </div>
        </div>

        {/* Technische Features (nachrangig) */}
        <details class="group mb-3">
          <summary class="text-xs text-[var(--color-text-muted)] cursor-pointer hover:text-[var(--color-text)] transition-colors flex items-center gap-1">
            <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            Technische Details
          </summary>
          <ul class="text-[var(--color-text-muted)] text-xs space-y-1 mt-2 ml-4">
            {item.features.map(feature => (
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-secondary)]">•</span> {feature}
              </li>
            ))}
          </ul>
        </details>

    <div class="flex flex-col gap-2 mt-4">
             <button data-action="add-to-wishlist" data-slug={item.slug} class="btn-primary w-full !px-3" aria-pressed="false">
                <span class="grid grid-cols-[auto_1fr] gap-4 items-start text-left">
                  <Icon name="heart" class="w-6 h-6 mt-0.5 shrink-0" />
                   <span class="merk-label text-base leading-tight">Merken</span>
                </span>
              </button>
           {item.detailPage && (
             <a href={item.detailPage} class="btn-secondary w-full text-center block">Mehr Infos</a>
           )}
         </div>
       </div>
     ))}
  </div>

<script>
  import { addItem, removeItem, hasItem } from '../lib/merklisteStore';

  function updateButton(btn: HTMLElement, inList: boolean) {
    btn.setAttribute('aria-pressed', String(inList));
    const label = btn.querySelector('.merk-label');
    if (label) label.textContent = inList ? 'Gemerkt' : 'Merken';
    btn.classList.toggle('btn-primary', !inList);
    btn.classList.toggle('btn-secondary', inList);
  }

  function initButtons() {
    document.querySelectorAll<HTMLElement>('[data-package-grid] [data-action="add-to-wishlist"]').forEach(btn => {
      const slug = btn.dataset.slug;
      if (slug) updateButton(btn, hasItem(slug));
    });
  }

  document.addEventListener('DOMContentLoaded', initButtons);
  document.addEventListener('astro:page-load', initButtons);

  document.addEventListener('click', (e) => {
    const target = e.target.closest('[data-action="add-to-wishlist"]') as HTMLElement | null;
    if (!target) return;
    if (!target.closest('[data-package-grid]')) return;
    const slug = target.dataset.slug;
    if (!slug) return;

    if (hasItem(slug)) {
      removeItem(slug);
      updateButton(target, false);
    } else {
      addItem(slug);
      updateButton(target, true);
    }
    document.dispatchEvent(new CustomEvent('toggle-merkliste'));
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import StickyMerkliste from '../../components/StickyMerkliste.astro';
import Icon from '../../components/Icon.astro';
import BrandBadges from '../vermietung/BrandBadges.astro';
import { getWebpUrl, getThumbUrl } from '../../lib/imageUtils';
import type { BreadcrumbSegment, FaqEntry, JsonLdItem, ProductData } from '@lib/types';

interface Props {
  pageTitle: string;
  title: string;
  description: string;
  image: string;
  keyword: string;
  intro: string;
  details: string;
  benefits: { title: string; text: string }[];
  steps: string[];
  products: ProductData[];
  faqs: FaqEntry[];
  jsonLd: JsonLdItem[];
  breadcrumbSegments: BreadcrumbSegment[];
  startingPrice: number;
  tone: string;
}

const {
  pageTitle,
  title,
  description,
  image,
  keyword,
  intro,
  details,
  benefits,
  steps,
  products,
  faqs,
  jsonLd,
  breadcrumbSegments,
  startingPrice,
  tone,
} = Astro.props;
---

<Layout
  title={pageTitle}
  description={description}
  image={image}
  preloadImage={image}
  pagefindType="technik"
  pagefindMeta={{ label: title, category: keyword }}
  jsonLd={jsonLd}
>
  <Navbar currentPage={Astro.url.pathname} />
  <Breadcrumb segments={breadcrumbSegments} />

  <section class="relative min-h-[52vh] flex items-center overflow-hidden">
    <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-24 px-4">
      <div class="max-w-5xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung in Stuttgart</span>
        <h1 class="font-play text-4xl md:text-6xl font-bold mt-4 mb-5 gradient-text">{title}</h1>
        <p class="text-[var(--color-text)] text-lg md:text-xl max-w-3xl mb-4">{intro}</p>
        <p class="text-[var(--color-text-muted)] max-w-3xl mb-6">{details}</p>
        <div class="flex flex-wrap gap-3">
          <span class="price-badge">ab {startingPrice}€</span>
          <span class="plug-badge-inline">
            <Icon name="check" class="w-4 h-4" />
            Inkl. Kabel &amp; Einweisung
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-play text-3xl md:text-4xl font-bold mb-8 text-center">Worauf es bei der Auswahl ankommt</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="card-base p-6">
            <h3 class="text-xl font-bold mb-2">{benefit.title}</h3>
            <p class="text-[var(--color-text-muted)] text-sm">{benefit.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-play text-3xl md:text-4xl font-bold mb-8 text-center">Passende Angebote aus meinem Verleih</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product, index) => (
          <div class="card-base equipment-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="relative">
              <picture>
                <source srcset={`${getThumbUrl(product.image)} 480w, ${getWebpUrl(product.image)} 960w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" type="image/webp" />
                <img
                  src={product.image}
                  alt={product.title}
                  width="400"
                  height="256"
                  loading="lazy"
                  decoding="async"
                  class="rounded-xl w-full h-64 object-cover mb-4 bg-[var(--color-surface)]"
                />
              </picture>
              <span class="plug-badge">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                Inkl. Kabel &amp; Einweisung
              </span>
            </div>
            <span class="price-badge">{product.price}</span>
            <BrandBadges brands={product.brands} class="mt-2" />
            <h3 class="text-xl font-bold mt-2 mb-3">{product.title}</h3>
            <p class="text-[var(--color-text-muted)] text-sm mb-4">{product.description}</p>
            {product.features.length > 0 && (
              <ul class="text-[var(--color-text-muted)] text-sm space-y-1 mb-4">
                {product.features.slice(0, 3).map(feature => (
                  <li class="flex items-center gap-2">
                    <span class="text-[var(--color-secondary)]">•</span> {feature}
                  </li>
                ))}
              </ul>
            )}
            <div class="flex flex-col gap-2 mt-auto">
              <a href={product.detailPage ?? '/vermietung'} class="btn-secondary w-full text-center block">Details ansehen</a>
              {product.packages && product.packages.length > 0 && (
                <div class="text-center text-xs text-[var(--color-text-muted)]">
                  In Paketen:{" "}
                  {product.packages.map((pkg) => (
                    <a href={pkg.url} class="text-[var(--color-secondary)] hover:underline mx-1">{pkg.name}</a>
                  ))}
                </div>
              )}
              <button data-action="add-to-wishlist" data-slug={product.slug} class="btn-primary w-full !px-3" aria-pressed="false">
                <span class="grid grid-cols-[auto_1fr] gap-4 items-start text-left">
                  <Icon name="heart" class="w-6 h-6 mt-0.5 shrink-0" />
                  <span class="text-base leading-tight">Merken</span>
                </span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-play text-3xl font-bold mb-6">So wählst du richtig</h2>
      <ol class="space-y-4">
        {steps.map((step, index) => (
          <li class="flex gap-4 items-start">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-secondary)] text-[var(--color-bg)] font-bold">{index + 1}</span>
            <p class="text-[var(--color-text-muted)]">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <FAQSection faqs={faqs} tone={tone} />
    </div>
  </section>

  <section class="cta-section section-padding bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto text-center px-4">
      <h2 class="font-play text-3xl font-bold mb-3">Noch unsicher?</h2>
      <p class="text-[var(--color-text-muted)] mb-6">Sag mir Anlass, Raumgröße und Personenzahl – ich stelle dir die passende Technik zusammen.</p>
      <a href="/vermietung#kontakt" class="btn-primary inline-block">Jetzt anfragen</a>
    </div>
  </section>

  <StickyMerkliste href="/vermietung#kontakt" />

  <Footer />

  <script>
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-action="add-to-wishlist"]')) {
        const btn = target.closest('[data-action="add-to-wishlist"]') as HTMLElement;
        const slug = btn?.getAttribute('data-slug');
        if (slug) {
          document.dispatchEvent(new CustomEvent('add-to-wishlist', { detail: { slug } }));
        }
      }
    });
  </script>
</Layout>

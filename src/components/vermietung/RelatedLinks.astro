---
interface RelatedItem {
  title: string;
  url: string;
  text: string;
}

interface Props {
  heading?: string;
  items: RelatedItem[];
}

const { heading = "Dazu passend", items } = Astro.props;
---

{items.length > 0 && (
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Kombinieren</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">{heading}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
          <a href={item.url} class="bg-[var(--color-surface)] p-6 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-all duration-300 block">
            <h3 class="font-play text-xl font-bold mb-2 text-[var(--color-text)]">{item.title} →</h3>
            <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

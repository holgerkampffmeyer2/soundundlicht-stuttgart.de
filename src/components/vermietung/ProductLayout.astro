---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import ProductGallery from './ProductGallery.astro';
import ProductCTA from '../ProductCTA.astro';
import StickyMerkliste from '../StickyMerkliste.astro';
import type { ProductData, PagefindMeta, JsonLdItem, BreadcrumbSegment } from '@lib/types';

interface Props {
  product: ProductData;
  pageTitle: string;
  title?: string;
  description: string;
  image: string;
  preloadImage: string;
  pagefindMeta: PagefindMeta;
  pagefindType?: string;
  jsonLd: JsonLdItem[];
  breadcrumbSegments: BreadcrumbSegment[];
  galleryImages?: string[];
  downloads?: { label: string; href: string; filename: string }[];
}

const { product, pageTitle, title, description, image, preloadImage, pagefindMeta, pagefindType = 'produkt', jsonLd, breadcrumbSegments, galleryImages, downloads } = Astro.props;
const layoutTitle = title ?? pageTitle;
const gallery = galleryImages ?? product.images ?? [];
const productSlug = product.slug;
const productTitle = product.title ?? pageTitle;

// Convert PagefindMeta to Record<string, string> for Layout
const pagefindMetaRecord: Record<string, string> = {};
if (pagefindMeta.price) pagefindMetaRecord.price = pagefindMeta.price;
if (pagefindMeta.image) pagefindMetaRecord.image = pagefindMeta.image;
if (pagefindMeta.category) pagefindMetaRecord.category = pagefindMeta.category;
if (pagefindMeta.label) pagefindMetaRecord.label = pagefindMeta.label;
---

<Layout 
  title={layoutTitle}
  description={description}
  image={image}
  preloadImage={preloadImage}
  pagefindType={pagefindType}
  pagefindMeta={pagefindMetaRecord}
  jsonLd={jsonLd}
>
  <Navbar currentPage={Astro.url.pathname} />
  <Breadcrumb segments={breadcrumbSegments} />
  
  <slot name="hero" />
  {gallery.length > 0 && (
    <ProductGallery images={gallery} title={pageTitle} />
  )}
  {downloads && downloads.length > 0 && (
    <section class="section-padding bg-[var(--color-bg)]">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Anleitung</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4 mb-4">Aufbauschema als PDF</h2>
        <p class="text-[var(--color-text-muted)] mb-8">Druckfreundliche Anleitung zum Aufbau und Anschluss.</p>
        <div class="flex flex-wrap justify-center gap-4">
          {downloads.map((d) => (
            <a href={d.href} download={d.filename} class="inline-flex items-center gap-3 bg-[var(--color-secondary)] text-[var(--color-bg)] font-bold px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">
              <Icon name="download" class="w-5 h-5" />
              {d.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <slot />

  <ProductCTA product={{ slug: productSlug, title: productTitle }} label={product.ctaLabel} />
  <StickyMerkliste href="/vermietung#kontakt" productSlug={productSlug} />

  <Footer />

  <script>
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const requestBtn = target.closest('[data-request-now]');
      
      if (requestBtn) {
        const slug = requestBtn.getAttribute('data-request-now');
        if (slug) {
          document.dispatchEvent(new CustomEvent('add-to-wishlist', { detail: { slug } }));
        }
      }
    });
  </script>
</Layout>

<style>
  .cta-section { 
    text-align: center; 
  }
</style>



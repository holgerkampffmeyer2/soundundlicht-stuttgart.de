---
interface DecisionItem {
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: DecisionItem[];
}

const { eyebrow = "Entscheidungshilfe", heading, intro, items } = Astro.props;
---

<section class="section-padding bg-[var(--color-bg)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">{eyebrow}</span>
      <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">{heading}</h2>
      {intro && <p class="text-[var(--color-text-muted)] mt-4 max-w-2xl mx-auto">{intro}</p>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <div class="bg-[var(--color-surface)] p-6 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-all duration-300">
          <h3 class="font-play text-xl font-bold mb-2">{item.title}</h3>
          <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

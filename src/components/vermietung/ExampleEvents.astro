---
import Icon from '../../components/Icon.astro';

interface ExampleEvent {
  title: string;
  description: string;
  personCount: string;
}

interface Props {
  events: ExampleEvent[];
}

const { events } = Astro.props;
---

<section class="section-padding section-padding--tight-top bg-[var(--color-bg)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Einsatzgebiete</span>
      <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Beispielanwendungen</h2>
    </div>

    <div class="events-grid">
      {events.map((event, index) => (
        <div class="event-card" style={`animation-delay: ${index * 0.15}s`}>
          <div class="event-icon">
            {event.title === "Hochzeit" && (
              <Icon name="heart" class="w-8 h-8" />
            )}
            {event.title === "Firmenfeier" && (
              <Icon name="building" class="w-8 h-8" />
            )}
            {event.title === "Vereinsfeier" && (
              <Icon name="users" class="w-8 h-8" />
            )}
            {event.title !== "Hochzeit" && event.title !== "Firmenfeier" && event.title !== "Vereinsfeier" && (
              <Icon name="calendar" class="w-8 h-8" />
            )}
          </div>
          
          <h3 class="event-title">{event.title}</h3>
          
          <div class="event-persons">
            <Icon name="users" class="w-5 h-5" />
            <span>{event.personCount}</span>
          </div>
          
          <p class="event-description">{event.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-padding--tight-top {
    padding-top: 1rem;
  }
  @media (min-width: 768px) {
    .section-padding--tight-top {
      padding-top: 1.5rem;
    }
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .events-grid:has(> :nth-child(4):last-child) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 768px) {
    .events-grid:has(> :nth-child(4):last-child) {
      grid-template-columns: 1fr;
    }
  }

  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    min-width: 0;
    transition: border-color 0.2s ease, transform 0.2s ease;
    animation: fadeInUp 0.6s ease forwards;
    opacity: 0;
  }

  .event-card:hover {
    border-color: var(--color-secondary);
    transform: translateY(-4px);
  }

  .event-icon {
    width: 56px;
    height: 56px;
    background: color-mix(in srgb, var(--color-secondary) 15%, transparent);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    margin-bottom: 1.25rem;
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
  }

  .event-persons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-secondary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .event-description {
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

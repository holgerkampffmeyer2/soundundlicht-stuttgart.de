---
import Icon from "./Icon.astro";

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  tone?: string;
  heading?: string;
  id?: string;
  showLink?: boolean;
}

const {
  faqs,
  tone = "allgemein",
  heading = "Häufig gestellte Fragen",
  id,
  showLink = true,
} = Astro.props as Props;

const TONE_ICONS: Record<string, string> = {
  allgemein: "chat",
  pakete: "package",
  sound: "volume-up",
  licht: "light-bulb",
  nebel: "light-bulb",
  standorte: "map-pin",
};

const icon = TONE_ICONS[tone] ?? "chat";
---
<div class="faq-list mt-16 mb-16" data-tone={tone} id={id}>
  <h2 class="font-play text-2xl md:text-3xl font-bold text-center mb-10">
    {heading}
  </h2>
  {faqs.length === 0 ? (
    <p class="text-center text-[var(--color-text-muted)]">No FAQs found for this page.</p>
  ) : (
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq: Faq) => (
        <details class="faq-item">
          <summary>
            <span class="faq-question-icon">
              <Icon name={icon} />
            </span>
            <span class="flex-1">{faq.question}</span>
            <Icon name="chevron-down" class="faq-chevron" />
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  )}
  {showLink && (
    <p class="text-center mt-8">
      <a href="/faq" class="text-[var(--color-accent)] hover:underline font-semibold">
        Alle Fragen zur Veranstaltungstechnik ansehen →
      </a>
    </p>
  )}
</div>

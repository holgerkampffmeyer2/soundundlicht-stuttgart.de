---
import { Picture } from 'astro:assets';
import logo from '@assets/logo/djhulk_logo.webp';
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
const linkClass = 'text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors';
const technikGroups = [
  {
    label: 'Pakete',
    links: [
      { href: '/vermietung/pakete', label: 'Alle Pakete' },
      { href: '/vermietung/partypaket-stuttgart', label: 'Partypaket' },
      { href: '/vermietung/veranstaltungspaket-stuttgart', label: 'Veranstaltungspaket' },
      { href: '/vermietung/djpaket-fildern', label: 'DJ-Paket' },
      { href: '/vermietung/akku-party-paket', label: 'Akku-Party-Paket' },
      { href: '/vermietung/karaoke-paket', label: 'Karaoke-Paket' },
      { href: '/vermietung/ld-systems-icoa-series', label: 'LD Systems PA Pakete' },
      { href: '/vermietung/ld-icoa-club-paket', label: 'LD ICOA Club-Paket' },
      { href: '/vermietung/ld-icoa-party-paket', label: 'LD ICOA Party-Paket' },
      { href: '/vermietung/ld-icoa-buehnen-paket', label: 'LD ICOA Bühnen-Paket' },
      { href: '/vermietung/ld-icoa-top-paar', label: 'LD ICOA Top-Paar' },
    ],
  },
  {
    label: 'Sound & DJ',
    links: [
      { href: '/vermietung/musikanlage', label: 'Musikanlage' },
      { href: '/vermietung/lautsprecher', label: 'Lautsprecher' },
      { href: '/vermietung/pa-anlage', label: 'PA-Anlage' },
      { href: '/vermietung/dj-equipment', label: 'DJ-Equipment' },
      { href: '/vermietung/jbl-partybox-300-320', label: 'JBL Partybox 300/320' },
      { href: '/vermietung/ld-maui-28g3', label: 'LD Maui 28 G3' },
      { href: '/vermietung/mikrofon-mischpult', label: 'Mikrofon & Mischpult' },
      { href: '/vermietung/powerstation', label: 'Powerstation' },
    ],
  },
  {
    label: 'Licht & Effekte',
    links: [
      { href: '/vermietung/partylicht', label: 'Partylicht' },
      { href: '/vermietung/partylicht-moving-head', label: 'Moving Heads' },
      { href: '/vermietung/led-scheinwerfer', label: 'LED-Scheinwerfer' },
      { href: '/vermietung/kls-laser-bar', label: 'KLS Laser Bar' },
      { href: '/vermietung/nebelmaschinen', label: 'Nebelmaschinen' },
      { href: '/vermietung/led-bossfx-nebelmaschine', label: 'LED BossFX Nebelmaschine' },
      { href: '/vermietung/max-party-bar', label: 'MAX Partybar' },
      { href: '/vermietung/mini-party-beamer', label: 'Mini Party Beamer' },
    ],
  },
];
---

<footer data-pagefind-ignore class="bg-[var(--color-bg)]/90 border-t border-[var(--color-border)] py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Company Info -->
      <div>
        <div class="flex items-center space-x-3 mb-4">
          <Picture src={logo} formats={['avif', 'webp', 'jpeg']} alt="Sound und Licht Stuttgart Logo" width={40} height={40} class="h-10" />
          <span class="font-play text-xl font-bold">Sound & Licht Stuttgart</span>
        </div>
        <p class="text-[var(--color-text-muted)] text-sm">
          Holger Kampffmeyer DJ Dienstleistungen<br>
          Vermietung von Partytechnik im Großraum Stuttgart
        </p>
        <p class="text-[var(--color-text-muted)] text-sm mt-2">
          Magellanstraße 4<br>
          70771 Echterdingen
        </p>

        <div class="mt-6">
          <h3 class="font-play font-bold text-lg mb-4">Externe Links</h3>
          <ul class="space-y-2">
            <li><a href="/faq" class={linkClass}>FAQ</a></li>
            <li><a href="/rss.xml" class={linkClass}>RSS Feed</a></li>
            <li><a href="/impressum" class={linkClass}>Impressum / Datenschutz</a></li>
            <li><a href="https://holger-kampffmeyer.de/" target="_blank" rel="noopener" class={linkClass}>DJ Hulk – Electronic Music →</a></li>
            <li><a href="https://medium.com/@holger.kampffmeyer/partytechnik-mieten-in-stuttgart-die-5-h%C3%A4ufigsten-fehler-und-warum-ich-meinen-eigenen-verleih-45c4189edbc6" target="_blank" rel="noopener" class={linkClass}>Tipps &amp; Tricks auf Medium →</a></li>
          </ul>
          <div class="flex gap-4 mt-4">
            <a href="https://www.facebook.com/holgerkampffmeyerdj" target="_blank" rel="noopener noreferrer nofollow" class="social-link" aria-label="Facebook">
              <Icon name="facebook" />
            </a>
            <a href="https://www.instagram.com/djhulk_de/" target="_blank" rel="noopener noreferrer nofollow" class="social-link" aria-label="Instagram">
              <Icon name="instagram" />
            </a>
          </div>
        </div>
      </div>
      
      <!-- Technik -->
      <div>
        <h3 class="font-play font-bold text-lg mb-4">Technik</h3>
        <div class="grid grid-cols-[repeat(2,minmax(0,1fr))] gap-x-6 gap-y-6">
          {technikGroups.map(group => (
            <div class="min-w-0 break-words">
              <h4 class="font-semibold text-sm mb-2">{group.label}</h4>
              <ul class="space-y-2">
                {group.links.map(link => (
                  <li><a href={link.href} class={linkClass}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Einzugsgebiet -->
      <div>
        <h3 class="font-play font-bold text-lg mb-4">Einzugsgebiet</h3>
        <div class="grid grid-cols-[repeat(2,minmax(0,1fr))] gap-x-6">
          <ul class="space-y-2 min-w-0 break-words">
            <li><a href="/stuttgart" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Stuttgart</a></li>
            <li><a href="/esslingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Esslingen</a></li>
            <li><a href="/tübingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Tübingen</a></li>
            <li><a href="/filderstadt" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Filderstadt</a></li>
            <li><a href="/leinfelden-echterdingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Leinfelden-Echterdingen</a></li>
            <li><a href="/kornwestheim" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Kornwestheim</a></li>
            <li><a href="/ludwigsburg" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Ludwigsburg</a></li>
            <li><a href="/böblingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Böblingen</a></li>
            <li><a href="/sindelfingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Sindelfingen</a></li>
            <li><a href="/leonberg" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Leonberg</a></li>
          </ul>
          <ul class="space-y-2 min-w-0 break-words">
            <li><a href="/waiblingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Waiblingen</a></li>
            <li><a href="/nürtingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Nürtingen</a></li>
            <li><a href="/reutlingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Reutlingen</a></li>
            <li><a href="/kirchheim-unter-teck" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Kirchheim unter Teck</a></li>
            <li><a href="/ostfildern" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Ostfildern</a></li>
            <li><a href="/fellbach" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Fellbach</a></li>
            <li><a href="/herrenberg" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Herrenberg</a></li>
            <li><a href="/winnenden" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Winnenden</a></li>
            <li><a href="/backnang" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Backnang</a></li>
            <li><a href="/metzingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Metzingen</a></li>
            <li><a href="/göppingen" class="text-[var(--color-text-muted)] hover:text-[var(--color-secondary)] transition-colors">Göppingen</a></li>
          </ul>
        </div>
      </div>

    </div>
    
    <div class="border-t border-[var(--color-border)] mt-8 pt-8 text-center">
      <p class="text-[var(--color-text-muted)] text-sm">
        &copy; {currentYear} Sound & Licht Stuttgart. Alle Rechte vorbehalten.
      </p>
    </div>
  </div>
</footer>

---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
import TechnicalSpecs from '../../components/vermietung/TechnicalSpecs.astro';
import RentalIncludes from '../../components/vermietung/RentalIncludes.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import DecisionHelp from '../../components/vermietung/DecisionHelp.astro';
import RelatedLinks from '../../components/vermietung/RelatedLinks.astro';
import IncludedInPackages from '../../components/vermietung/IncludedInPackages.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceArea } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'powerstation')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "Powerstation" }
];

const pageTitle = "Powerstation mieten in Stuttgart | Sound & Licht Stuttgart";

const faqs = await getFaqsForPage('powerstation');

const images = [
  "/img/vermietung/enginestar-akku2.webp"
];

const siteUrl = "https://soundundlicht-stuttgart.de";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Powerstation Vermietung",
  "description": "Miete die tragbare EnginStar R350 Powerstation mit 296Wh Kapazität für Outdoor-Events ohne Stromanschluss. 350W reine Sinuswelle, 2x 230V, USB-C.",
  "image": [
    siteUrl + images[0]
  ],
  "serviceType": "Veranstaltungstechnik-Vermietung",
  "areaServed": serviceArea,
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://soundundlicht-stuttgart.de/#business"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": product.priceValue,
      "priceCurrency": "EUR",
      "unitCode": "DAY"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://soundundlicht-stuttgart.de/"},
    {"@type": "ListItem", "position": 2, "name": "Vermietung", "item": "https://soundundlicht-stuttgart.de/vermietung"},
    {"@type": "ListItem", "position": 3, "name": "Powerstation", "item": "https://soundundlicht-stuttgart.de/vermietung/powerstation"}
  ]
};

const specs = {
  "Modell": "EnginStar R350 Portable Power Station",
  "Dauerleistung": "350 W (reine Sinuswelle)",
  "Kapazität": "296 Wh (ca. 80.000 mAh)",
  "Ausgänge": "2x 230V Schuko, 2x USB-A, 1x USB-C",
  "Integriertes Licht": "LED-Leuchte mit 3 Modi",
  "Besonderheiten": "Inkl. Transporttasche, kompakt & tragbar"
};

const rentalIncludes = [
  "1x EnginStar R350 Powerstation",
  "1x Transporttasche",
  "1x Ladegerät / Netzkabel",
  "Einweisung bei der Abholung"
];

const events = [
  {
    title: "Outdoor-Party",
    description: "Musik und Licht im Garten oder auf der Wiese ganz ohne Steckdose. Die Powerstation versorgt Partybox, Lichteffekte und Handy-Laden zuverlässig.",
    personCount: "bis 50 Personen"
  },
  {
    title: "Hochzeit",
    description: "Für Trauungen und Feiern an Locations ohne Strom sorgt die Powerstation für eine saubere Stromversorgung von Beschallung und Ambientelicht.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Firmenfeier",
    description: "Ob Firmenausflug, Sommerfest oder Stand auf der Festwiese – mit der tragbaren Powerstation bist du unabhängig vom nächsten Stromanschluss.",
    personCount: "bis 50 Personen"
  }
];

const packageLinks = [
  { name: "Akku-Party-Paket", url: "/vermietung/akku-party-paket" }
];
---

<ProductLayout
  product={product}
  pageTitle={pageTitle}
  description="Miete die tragbare EnginStar R350 Powerstation mit 296Wh Kapazität für Outdoor-Events ohne Stromanschluss. 350W reine Sinuswelle, 2x 230V, USB-C."
  image="/img/vermietung/enginestar-akku2.webp"
  preloadImage="/img/vermietung/enginestar-akku2.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Licht", label: "EnginStar R350 Powerstation" }}
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
  breadcrumbSegments={breadcrumbSegments}
>
  <!-- Hero -->
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/enginestar-akku2.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Einweisung
          </span>
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">Powerstation mieten</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Die EnginStar R350 ist eine tragbare Powerstation mit 296Wh Kapazität und 350W reiner Sinuswelle.
          Sie versorgt Lautsprecher, Lichttechnik und Handys auch dort zuverlässig, wo kein Stromanschluss vorhanden ist – ideal für Outdoor-Partys, Feiern auf der Wiese und Locations ohne Versorgung.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Preis & Kaution -->
  <RentalPricing price={product.price} deposit={100} />

  <!-- 3. Technische Spezifikation -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Technische Daten</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">EnginStar R350 Powerstation</h2>
      </div>
      <TechnicalSpecs specs={specs} />
    </div>
  </section>

  <!-- 4. Entscheidungshilfe -->
  <DecisionHelp
    heading="Wann brauchst du eine Powerstation?"
    intro="Eine Powerstation ersetzt dort die Steckdose, wo kein Stromanschluss verfügbar ist – oder wo du keine langen Kabel legen willst."
    items={[
      { title: "Location ohne Strom", text: "Garten, Festwiese oder Scheune ohne Steckdose: Die Powerstation versorgt Sound und Licht für die gesamte Feier." },
      { title: "Kurzer Aufbau ohne Kabel", text: "Statt Verlängerungskabel quer über den Platz steht die Powerstation direkt neben der Technik – sauber und stolperfrei." },
      { title: "Empfindliche Elektronik", text: "Die reine Sinuswelle schützt Lautsprecher und Beleuchtung vor Schäden, die bei billigen Generatoren auftreten können." },
      { title: "Notreserve", text: "Als Absicherung bei wackeliger Stromversorgung hält sie dein Setup am Laufen, wenn die Location überlastet ist." }
    ]}
  />

  <!-- 5. Lieferumfang -->
  <RentalIncludes items={rentalIncludes} />

  <!-- 6. Beispielanwendungen -->
  <ExampleEvents events={events} />

  <!-- 6b. Dazu passend -->
  <RelatedLinks
    items={[
      { title: "Akku LED PAR Lichter", url: "/vermietung/led-scheinwerfer#akku-led-par", text: "Betreibe die Akku-Scheinwerfer direkt über die Powerstation – Licht ohne jede Steckdose." },
      { title: "Akku-Party-Paket", url: "/vermietung/akku-party-paket", text: "Das komplette Outdoor-Set: JBL Partyboxen, LED-Licht und Powerstation als fertiges Paket." },
      { title: "JBL Partybox 300/320", url: "/vermietung/jbl-partybox-300-320", text: "Die mobile Soundlösung, die perfekt zur Powerstation passt, wenn kein Strom verfügbar ist." }
    ]}
  />

  <!-- 7. In Paketen enthalten -->
  <div class="max-w-4xl mx-auto px-4">
    <IncludedInPackages packages={packageLinks} />
  </div>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-play text-2xl md:text-3xl font-bold text-center mb-10">
        Häufig gestellte Fragen
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-details bg-[var(--color-surface)] rounded-xl p-4 cursor-pointer">
            <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
              <span class="faq-icon">
                <Icon name="chevron-right" class="w-3 h-3" />
              </span>
              {faq.question}
            </summary>
            <p class="text-[var(--color-text-muted)] mt-3 ml-9">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</ProductLayout>

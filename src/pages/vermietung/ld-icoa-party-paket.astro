---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
import PackageContents from '../../components/vermietung/PackageContents.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import RelatedLinks from '../../components/vermietung/RelatedLinks.astro';
import Testimonials from '../../components/Testimonials.astro';
import BrandBadges from '../../components/vermietung/BrandBadges.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceJsonLd, videoJsonLd, faqPageJsonLd, breadcrumbJsonLd } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'ld-icoa-party-paket')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "LD ICOA System", href: "/vermietung/ld-systems-icoa-series" },
  { label: "Partypaket XL" }
];

const pageTitle = "2x ICOA Fullrange-Lautsprecher + 1x Bassreflex-PA-Subwoofer mieten in Stuttgart | Sound & Licht Stuttgart";
const faqs = await getFaqsForPage('ld-icoa-party-paket');

const images = [
  "/img/vermietung/icoa/LD-Systems-Icoa-Party-Paket.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-2sat-1sub.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-2sat-1-sub-2.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-detail-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-detail-back.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-Sat-detail.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-detail-sat-and-sub.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sub-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-Sub-detail.webp",
  "/img/vermietung/icoa/ld-icoa-party-paket-digital.svg"
];

const packageItems = [
  { name: "2x LD Systems ICOA 12 A – Aktive Fullrange-Lautsprecher", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-12-a" },
  { name: "1x LD Systems ICOA SUB 15 A – Aktiver Bassreflex-PA-Subwoofer", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-sub-15-a" },
  { name: "1x Gravity SP 2332 B Distanzstange", detailPage: "/vermietung/ld-systems-icoa-series#zubehoer" },
  { name: "1x Dreibein-Lautsprecherstativ", detailPage: "/vermietung/ld-systems-icoa-series#zubehoer" },
  { name: "XLR- und Stromkabel" }
];

const events = [
  {
    title: "Privat-Party & Geburtstag",
    description: "Das Partypaket XL liefert satten Bass durch den Sub, bleibt aber kompakt im Aufbau. Perfekt für Geburtstage, Gartenpartys oder After-Work-Parties bis 100 Gäste.",
    personCount: "60–100 Personen"
  },
  {
    title: "DJ-Gig & Club-Abend",
    description: "Für mobile DJs auf kleineren bis mittleren Events: Der eine Sub liefert genug Punch für Tanzmusik, die Tops bleiben klar. Kompakter Footprint für enge DJ-Booths.",
    personCount: "60–120 Personen"
  },
  {
    title: "Bandprobe & Live-Musik",
    description: "Gesang, Gitarre, Keys, E-Drums kommen sauber durch. Der eine Sub entlastet die Tops im Tiefton, reicht für Proberäume und kleinere Gigs.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Feiern mit begrenztem Platz",
    description: "Wenn der Platz für zwei Subs fehlt (schmale Räume, niedrige Decken, Treppenaufgänge), liefert das Partypaket XL mit einem Sub genug Bassfundament bei kompaktem Footprint.",
    personCount: "60–100 Personen"
  },
  {
    title: "Bühnenmonitoring",
    description: "Eines der beiden Tops lässt sich horizontal als Monitor aufstellen (55° Winkel). Die Koaxial-Bauweise sorgt für saubere Ortung auch bei lauter Bühne.",
    personCount: "flexibel"
  }
];

const packageFeatures = [
  "2x ICOA 12 A Fullrange-Lautsprecher, 300 W RMS / 1200 W Peak, 126 dB max. SPL",
  "1x ICOA SUB 15 A Bassreflex-PA-Subwoofer, 400 W RMS / 1600 W Peak, Bass bis 36 Hz",
  "Distanzstange für den Sub, ein Dreibein-Stativ für das zweite Top",
  "Fullrange-Lautsprecher auch horizontal als Monitor nutzbar (55° Winkel)",
  "DynX DSP mit 4 Presets (Crossover 80/100/120 Hz + Cardioid)",
  "XLR- und Stromkabel inklusive",
  "Kompaktes Paket für Kombi oder kleinen Transporter",
  "Ideal bei begrenztem Platz: nur ein Sub nötig",
  "Persönliche Einweisung bei der Abholung"
];

const serviceJsonLdData = JSON.parse(JSON.stringify(serviceJsonLd(product, images)));
const breadcrumbJsonLdData = JSON.parse(JSON.stringify(breadcrumbJsonLd(breadcrumbSegments)));
const faqPageJsonLdData = JSON.parse(JSON.stringify(faqPageJsonLd(faqs)));

const videoPublisher = {
  "@type": "Organization",
  "name": "Sound und Licht Stuttgart - Holger Kampffmeyer",
  "logo": { "@type": "ImageObject", "url": "https://soundundlicht-stuttgart.de/img/djhulk_logo.webp" }
};
const videoJsonLdData = JSON.parse(JSON.stringify(videoJsonLd(
  "j5Fz4n10jyI",
  "Showcase LD Systems Icoa Bundle: 2 15Inch Subs and 2 12Inch Satellites",
  "Kurzes Produktvideo zum LD Systems ICOA System: 12-Zoll-Topteile und 15-Zoll-Subwoofer im Einsatz.",
  images[0],
  videoPublisher,
  { uploadDate: "2026-11-17T18:56:18+00:00", duration: "PT42S" }
)));
---

<ProductLayout
  product={product}
  pageTitle={pageTitle}
  description="Miete das Partypaket XL LD ICOA in Stuttgart: 2x ICOA 12 A, 1x ICOA SUB 15 A, Distanzstange, Stativ und Kabel ab 130€/Tag. Ideal für Privat-Partys, DJs, Bandproben, Theater oder bei begrenztem Platz – bis ca. 120 Personen."
  image="/img/vermietung/icoa/LD-Systems-Icoa-Party-Paket.webp"
  preloadImage="/img/vermietung/icoa/LD-Systems-Icoa-Party-Paket.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Paket", label: "Partypaket XL LD ICOA" }}
  jsonLd={[serviceJsonLdData, breadcrumbJsonLdData, faqPageJsonLdData, videoJsonLdData]}
  galleryImages={images}
  downloads={[{ label: "Anleitung herunterladen (PDF)", href: "/downloads/icoa/ld-icoa-party-paket-druck.pdf", filename: "ld-icoa-party-paket-druck.pdf" }]}
  breadcrumbSegments={breadcrumbSegments}
>
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/icoa/LD-Systems-Icoa-Party-Paket.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel, Zubehör & Einweisung
          </span>
          <BrandBadges brands={product.brands} />
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">2x ICOA Fullrange-Lautsprecher + 1x Bassreflex-PA-Subwoofer</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Das kompakte Party-Paket: zwei ICOA 12 A Fullrange-Lautsprecher, ein ICOA SUB 15 A Bassreflex-PA-Subwoofer, Distanzstange und ein Dreibein-Stativ. Ein Fullrange-Lautsprecher steht auf dem Sub, das andere auf dem Stativ – oder beide als Monitore.<br />
          Das XL-Paket für Privat-Partys, DJs und Bandproben: ein Sub liefert Bassfundament bei kompaktem Footprint. Ideal bei begrenztem Platz. Kabel & Einweisung inklusive.
        </p>
      </div>
    </div>
  </section>


  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Highlights</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Partypaket XL: Kompakt & bassstark</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {packageFeatures.map((feature) => (
          <div class="bg-[var(--color-bg)] p-6 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-all duration-300">
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-secondary)] text-2xl">✓</span>
              <p class="text-[var(--color-text)]">{feature}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Produktvideo -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Video</span>
        <h2 class="font-play text-3xl font-bold mt-2">ICOA im Einsatz</h2>
        <p class="text-[var(--color-text-muted)] mt-2">Ein kurzer Eindruck vom LD Systems ICOA System in Aktion</p>
      </div>
      <div class="mx-auto w-full max-w-[360px] aspect-[9/16] rounded-xl overflow-hidden bg-[var(--color-surface)]">
        <iframe
          src="https://www.youtube-nocookie.com/embed/j5Fz4n10jyI"
          title="Showcase LD Systems Icoa Bundle: 2 15Inch Subs and 2 12Inch Satellites"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <RentalPricing price={product.price} deposit={200} />

  <PackageContents title="Enthalten im Partypaket XL" items={packageItems} />

  <ExampleEvents events={events} />

  <RelatedLinks
    items={[
      { title: "Club-Paket LD ICOA", url: "/vermietung/ld-icoa-club-paket", text: "Zwei Subs, Cardioid-Modus, mehr Bassreserve für Clubs, mobile DJs und Feiern bis 200 Personen." },
      { title: "Top-Paar LD ICOA", url: "/vermietung/ld-icoa-top-paar", text: "Nur zwei Tops ohne Sub – für Sprache, Monitoring und sehr kleine Feiern." },
      { title: "ICOA System & Einzelgeräte", url: "/vermietung/ld-systems-icoa-series", text: "Top und Sub einzeln mieten, technische Daten und Zubehör im Überblick." }
    ]}
  />

  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-play text-2xl md:text-3xl font-bold text-center mb-10">
        Häufig gestellte Fragen
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-details bg-[var(--color-surface)] rounded-xl p-4 cursor-pointer">
            <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
              <span class="faq-icon">
                <Icon name="chevron-right" class="w-3 h-3" />
              </span>
              {faq.question}
            </summary>
            <p class="text-[var(--color-text-muted)] mt-3 ml-9">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
      <p class="text-center mt-6">
        <a href="/faq" class="text-[var(--color-secondary)] hover:underline font-semibold">Alle Fragen zur Veranstaltungstechnik ansehen →</a>
      </p>
    </div>
  </section>

  <Testimonials />
</ProductLayout>

---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
import PackageContents from '../../components/vermietung/PackageContents.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import RelatedLinks from '../../components/vermietung/RelatedLinks.astro';
import Testimonials from '../../components/Testimonials.astro';
import BrandBadges from '../../components/vermietung/BrandBadges.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceJsonLd, faqPageJsonLd, breadcrumbJsonLd } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'ld-icoa-club-paket')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "Club-Paket LD ICOA" }
];

const pageTitle = "Club-Paket mieten in Stuttgart | Sound & Licht Stuttgart";
const faqs = await getFaqsForPage('ld-icoa-club-paket');

const images = ["/img/vermietung/icoa-placeholder.webp"];

const packageItems = [
  { name: "2x LD Systems ICOA 12 A Topteile", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-12-a" },
  { name: "2x LD Systems ICOA SUB 15 A Subwoofer", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-sub-15-a" },
  { name: "2x Gravity SP 2332 B Distanzstange", detailPage: "/vermietung/ld-systems-icoa-series#zubehoer" },
  { name: "XLR- und Stromkabel" }
];

const events = [
  {
    title: "Mobile DJs & Club-Abende",
    description: "Zwei 15\"-Subs und zwei 12\"-Tops liefern den Druck und die Klarheit für Tanzabende, Club-Nächte und mobile DJ-Gigs. Mit dem Cardioid-Preset bleibt der Bass auf der Bühne kontrolliert.",
    personCount: "100–200 Personen"
  },
  {
    title: "Große Feiern",
    description: "Geburtstag, Hochzeit oder Firmenfeier: Das Club-Paket trägt Musik, Reden und Hintergrundbeschallung auch in größeren Räumen oder im Zelt.",
    personCount: "100–200 Personen"
  },
  {
    title: "Band & Live-Musik",
    description: "Für Bands mit Gesang, Gitarre, Keys und E-Drums bietet das Paket genug Reserven. Die Tops lassen sich bei Bedarf auch als Bühnenmonitore einsetzen.",
    personCount: "bis 150 Personen"
  },
  {
    title: "Ersatz-PA bei Ausfall",
    description: "Wenn deine eigene Anlage kurzfristig ausfällt, ist das Club-Paket eine schnelle, vollwertige Ersatzlösung. Melde dich telefonisch, dann prüfe ich die Verfügbarkeit sofort.",
    personCount: "kurzfristig möglich"
  }
];

const packageFeatures = [
  "2x ICOA 12 A mit 1200 W Peak und 126 dB max. SPL",
  "2x ICOA SUB 15 A mit 1600 W Peak und Bass bis 36 Hz",
  "DynX DSP mit Crossover-Presets und Cardioid-Modus",
  "Tops auf Distanzstangen direkt auf den Subs",
  "XLR- und Stromkabel inklusive",
  "Auch als Ersatz-PA oder für Live-Musik nutzbar",
  "Kompakt genug für den Transport im Kombi",
  "Persönliche Einweisung bei der Abholung"
];

const serviceJsonLdData = JSON.parse(JSON.stringify(serviceJsonLd(product, images)));
const breadcrumbJsonLdData = JSON.parse(JSON.stringify(breadcrumbJsonLd(breadcrumbSegments)));
const faqPageJsonLdData = JSON.parse(JSON.stringify(faqPageJsonLd(faqs)));
---

<ProductLayout
  product={product}
  pageTitle={pageTitle}
  description="Miete das LD ICOA Club-Paket in Stuttgart: 2x ICOA 12 A, 2x ICOA SUB 15 A, Distanzstangen und Kabel ab 150€/Tag. Haupt-PA für mobile DJs, Clubs, Bands und Feiern bis ca. 200 Personen."
  image="/img/vermietung/icoa-placeholder.webp"
  preloadImage="/img/vermietung/icoa-placeholder.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Paket", label: "Club-Paket LD ICOA" }}
  jsonLd={[serviceJsonLdData, breadcrumbJsonLdData, faqPageJsonLdData]}
  breadcrumbSegments={breadcrumbSegments}
>
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/icoa-placeholder.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel, Zubehör & Einweisung
          </span>
          <BrandBadges brands={product.brands} />
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">Club-Paket LD ICOA</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Das größte ICOA-Paket: zwei ICOA 12 A Topteile auf zwei ICOA SUB 15 A Subwoofern, verbunden mit Gravity-Distanzstangen. Zusammen ergibt das eine kompakte, aktiv betriebene PA mit viel Bassreserve für mobile DJs, Bands und größere Feiern.<br />
          XLR- und Stromkabel sind ebenso inklusive wie die Einweisung. Du holst das Paket ab, baust es in etwa 45 Minuten auf und legst los – ohne zusätzliche Endstufen oder externes DSP.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Highlights</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Was das Club-Paket kann</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {packageFeatures.map((feature) => (
          <div class="bg-[var(--color-bg)] p-6 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-all duration-300">
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-secondary)] text-2xl">✓</span>
              <p class="text-[var(--color-text)]">{feature}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <RentalPricing price={product.price} deposit={200} />

  <PackageContents title="Enthalten im Club-Paket" items={packageItems} />

  <ExampleEvents events={events} />

  <RelatedLinks
    items={[
      { title: "Partypaket XL LD ICOA", url: "/vermietung/ld-icoa-party-paket", text: "Kompakte Variante mit einem Sub – für Privat-Partys, DJs, Bandproben bei begrenztem Platz." },
      { title: "Top-Paar LD ICOA", url: "/vermietung/ld-icoa-top-paar", text: "Nur zwei Tops ohne Sub – für Sprache, Monitoring und sehr kleine Feiern." },
      { title: "ICOA System & Einzelgeräte", url: "/vermietung/ld-systems-icoa-series", text: "Top und Sub einzeln mieten, technische Daten und Zubehör im Überblick." }
    ]}
  />

  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-play text-2xl md:text-3xl font-bold text-center mb-10">
        Häufig gestellte Fragen
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-details bg-[var(--color-surface)] rounded-xl p-4 cursor-pointer">
            <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
              <span class="faq-icon">
                <Icon name="chevron-right" class="w-3 h-3" />
              </span>
              {faq.question}
            </summary>
            <p class="text-[var(--color-text-muted)] mt-3 ml-9">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
      <p class="text-center mt-6">
        <a href="/faq" class="text-[var(--color-secondary)] hover:underline font-semibold">Alle Fragen zur Veranstaltungstechnik ansehen →</a>
      </p>
    </div>
  </section>

  <Testimonials />
</ProductLayout>

---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import PackageContents from '../../components/vermietung/PackageContents.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import RelatedLinks from '../../components/vermietung/RelatedLinks.astro';
import Testimonials from '../../components/Testimonials.astro';
import BrandBadges from '../../components/vermietung/BrandBadges.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceJsonLd, videoJsonLd, videoPublisherJsonLd, faqPageJsonLd, breadcrumbJsonLd } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'ld-icoa-club-paket')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "LD ICOA System", href: "/vermietung/ld-systems-icoa-series" },
  { label: "Club-Paket" }
];

const pageTitle = "2x ICOA Fullrange-Lautsprecher + 2x Bassreflex-PA-Subwoofer mieten in Stuttgart | Sound & Licht Stuttgart";
const faqs = getFaqsForPage('ld-icoa-club-paket');

const images = [
  "/img/vermietung/icoa/LD-Systems-Icoa-Club-Paket.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-2sat-2subs.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-2sat-2-subs-2.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-detail-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sat-detail-back.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-Sat-detail.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-detail-sat-and-sub.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-sub-front.webp",
  "/img/vermietung/icoa/LD-Systems-Icoa-Sub-detail.webp",
  "/img/vermietung/icoa/ld-icoa-club-paket-digital.svg"
];

const packageItems = [
  { name: "2x LD Systems ICOA 12 A – Aktive Fullrange-Lautsprecher", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-12-a" },
  { name: "2x LD Systems ICOA SUB 15 A – Aktive Bassreflex-PA-Subwoofer", detailPage: "/vermietung/ld-systems-icoa-series#ld-icoa-sub-15-a" },
  { name: "2x Gravity SP 2332 B Distanzstange", detailPage: "/vermietung/ld-systems-icoa-series#zubehoer" },
  { name: "XLR- und Stromkabel" }
];

const events = [
  {
    title: "DJ Kollektive & Raves",
    description: "Zwei 15\"-Subs mit 131 dB und Bass bis 36 Hz liefern den druckvollen Tiefton, den Techno, House und Bass Music brauchen. Cardioid-Modus hält den Bass auf der Tanzfläche, nicht hinter der Bühne. Kompakt genug für Transporter/Kombi – ideal für mobile Raves, Open-Airs und Club-Übernahmen.",
    personCount: "100–200 Personen"
  },
  {
    title: "Mobile DJs & Club-Abende",
    description: "Zwei 15\"-Subs und zwei 12\"-Tops liefern den Druck und die Klarheit für Tanzabende, Club-Nächte und mobile DJ-Gigs. Mit dem Cardioid-Preset bleibt der Bass auf der Bühne kontrolliert.",
    personCount: "100–200 Personen"
  },
  {
    title: "Große Feiern",
    description: "Geburtstag, Hochzeit oder Firmenfeier: Das Club-Paket trägt Musik, Reden und Hintergrundbeschallung auch in größeren Räumen oder im Zelt.",
    personCount: "100–200 Personen"
  },
  {
    title: "Band & Live-Musik",
    description: "Für Bands mit Gesang, Gitarre, Keys und E-Drums bietet das Paket genug Reserven. Die Tops lassen sich bei Bedarf auch als Bühnenmonitore einsetzen.",
    personCount: "bis 150 Personen"
  },
  {
    title: "Ersatz-PA bei Ausfall",
    description: "Wenn deine eigene Anlage kurzfristig ausfällt, ist das Club-Paket eine schnelle, vollwertige Ersatzlösung. Melde dich telefonisch, dann prüfe ich die Verfügbarkeit sofort.",
    personCount: "kurzfristig möglich"
  }
];

const packageFeatures = [
  "2x ICOA 12 A Fullrange-Lautsprecher, 300 W RMS / 1200 W Peak, 126 dB max. SPL",
  "2x ICOA SUB 15 A Bassreflex-PA-Subwoofer, 400 W RMS / 1600 W Peak, Bass bis 36 Hz – <strong>ideal für Bass Music, Techno, House</strong>",
  "DynX DSP mit 4 Presets (Crossover 80/100/120 Hz + Cardioid) – <strong>kontrollierter Bass auf der Tanzfläche</strong>",
  "Fullrange-Lautsprecher auf Distanzstangen direkt auf den Subs",
  "XLR- und Stromkabel inklusive",
  "Auch als Ersatz-PA oder für Live-Musik nutzbar",
  "Kompakt für Kombi/Transporter – <strong>perfekt für mobile Raves & Open-Airs</strong>",
  "Persönliche Einweisung bei der Abholung"
];

const serviceJsonLdData = JSON.parse(JSON.stringify(serviceJsonLd(product, images)));
const breadcrumbJsonLdData = JSON.parse(JSON.stringify(breadcrumbJsonLd(breadcrumbSegments)));
const faqPageJsonLdData = JSON.parse(JSON.stringify(faqPageJsonLd(faqs)));

const videoJsonLdData = JSON.parse(JSON.stringify(videoJsonLd(
  "j5Fz4n10jyI",
  "Showcase LD Systems Icoa Bundle: 2 15Inch Subs and 2 12Inch Satellites",
  "Kurzes Produktvideo zum LD Systems ICOA System: 12-Zoll-Topteile und 15-Zoll-Subwoofer im Einsatz.",
  images[0],
  videoPublisherJsonLd,
  { uploadDate: "2026-11-17T18:56:18+00:00", duration: "PT42S" }
)));
---

<ProductLayout
  product={product}
  pageTitle={pageTitle}
  description="Miete das LD ICOA Club-Paket in Stuttgart: 2x ICOA 12 A, 2x ICOA SUB 15 A (Bass bis 36 Hz, 131 dB), Distanzstangen & Kabel ab 150€/Tag. Haupt-PA für mobile DJs, DJ-Kollektive, Raves, Clubs, Bands & Feiern bis 200 Pers. Cardioid-ready, kombi-transportabel."
  image="/img/vermietung/icoa/LD-Systems-Icoa-Club-Paket.webp"
  preloadImage="/img/vermietung/icoa/LD-Systems-Icoa-Club-Paket.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Paket", label: "Club-Paket LD ICOA" }}
  jsonLd={[serviceJsonLdData, breadcrumbJsonLdData, faqPageJsonLdData, videoJsonLdData]}
  galleryImages={images}
  downloads={[{ label: "Anleitung herunterladen (PDF)", href: "/downloads/icoa/ld-icoa-club-paket-druck.pdf", filename: "ld-icoa-club-paket-druck.pdf" }]}
  breadcrumbSegments={breadcrumbSegments}
>
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/icoa/LD-Systems-Icoa-Club-Paket.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel, Zubehör & Einweisung
          </span>
          <BrandBadges brands={product.brands} />
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">2x ICOA Fullrange-Lautsprecher + 2x Bassreflex-PA-Subwoofer</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Das größte ICOA-Paket: zwei ICOA 12 A Fullrange-Lautsprecher auf zwei ICOA SUB 15 A Bassreflex-PA-Subwoofern, verbunden mit Gravity-Distanzstangen. Zusammen ergibt das eine kompakte, aktiv betriebene PA mit viel Bassreserve für mobile DJs, DJ-Kollektive, Raves, Bands und größere Feiern.<br />
          XLR- und Stromkabel sind ebenso inklusive wie die Einweisung. Du holst das Paket ab, baust es in etwa 45 Minuten auf und legst los – ohne zusätzliche Endstufen oder externes DSP.
        </p>
      </div>
    </div>
  </section>


  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Highlights</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Was das Club-Paket kann</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {packageFeatures.map((feature) => (
          <div class="bg-[var(--color-bg)] p-6 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-all duration-300">
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-secondary)] text-2xl">✓</span>
              <p class="text-[var(--color-text)]" set:html={feature}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Produktvideo -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Video</span>
        <h2 class="font-play text-3xl font-bold mt-2">ICOA im Einsatz</h2>
        <p class="text-[var(--color-text-muted)] mt-2">Ein kurzer Eindruck vom LD Systems ICOA System in Aktion</p>
      </div>
      <div class="mx-auto w-full max-w-[360px] aspect-[9/16] rounded-xl overflow-hidden bg-[var(--color-surface)]">
        <iframe
          src="https://www.youtube-nocookie.com/embed/j5Fz4n10jyI"
          title="Showcase LD Systems Icoa Bundle: 2 15Inch Subs and 2 12Inch Satellites"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <RentalPricing price={product.price} deposit={200} />

  <PackageContents title="Enthalten im Club-Paket" items={packageItems} />

  <ExampleEvents events={events} />

  <RelatedLinks
    items={[
      { title: "Partypaket XL LD ICOA", url: "/vermietung/ld-icoa-party-paket", text: "Kompakte Variante mit einem Sub – für Privat-Partys, DJs, Bandproben bei begrenztem Platz." },
      { title: "Top-Paar LD ICOA", url: "/vermietung/ld-icoa-top-paar", text: "Nur zwei Tops ohne Sub – für Sprache, Monitoring und sehr kleine Feiern." },
      { title: "ICOA System & Einzelgeräte", url: "/vermietung/ld-systems-icoa-series", text: "Top und Sub einzeln mieten, technische Daten und Zubehör im Überblick." }
    ]}
  />

  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <FAQSection faqs={faqs} tone="pakete" />
    </div>
  </section>

  <Testimonials />
</ProductLayout>

---
import TechnicalLandingLayout from '../../components/vermietung/TechnicalLandingLayout.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { technicalLandingData } from '../../lib/technicalLanding';

const allProducts = await getCollection('products');
const slugs = ['djpaket-fildern', 'mikrofon', 'kls-laser-bar'];
const products = slugs
  .map((slug) => allProducts.find((entry) => entry.data.slug === slug)?.data)
  .filter((product) => product !== undefined);

const faqs = getFaqsForPage('dj-equipment');
const priceValue = 200;
const title = 'DJ-Equipment mieten in Stuttgart';
const description = 'Kurzfristig Ersatz-PA mieten: Ich stelle PA, Lichttechnik, Mikrofon und Nebelmaschine – DJ-Mixer und Kopfhörer bringst du selbst mit. Ab 200€ pro Tag.';
const { breadcrumbSegments, jsonLd } = technicalLandingData({
  title,
  description,
  label: 'DJ-Equipment',
  priceValue,
  products,
  faqs,
});
---

<TechnicalLandingLayout
  pageTitle="DJ-Equipment mieten in Stuttgart | Sound & Licht Stuttgart"
  title={title}
  description={description}
  image="/img/vermietung/djpaket.webp"
  keyword="DJ-Equipment mieten Stuttgart"
  intro="Du brauchst kurzfristig eine Ersatz-PA oder hast als Club-DJ keine eigene? Ich stelle dir PA und Lichttechnik zusammen – inklusive Mikrofon und Nebelmaschine."
  details="Du holst das Set bei mir in Echterdingen ab. Deinen DJ-Mixer und deine Kopfhörer bringst du selbst mit; ich zeige dir Signalweg, Kabel und Einstellungen, damit du direkt loslegen kannst."
  benefits={[
    { title: 'Kurzfristig einsatzbereit', text: 'Wenn deine PA ausfällt oder du keine eigene hast, bekommst du bei mir ein komplettes Sound- und Lichtset.' },
    { title: 'Alles an Bord außer DJ-Teil', text: 'PA, Licht, Mikrofon und Nebelmaschine stelle ich. Mixer und Kopfhörer gehören zu deinem eigenen Setup.' },
    { title: 'Kurz eingewiesen', text: 'Ich erkläre dir bei der Abholung den Signalweg und wie du alles wieder zusammenpackst.' },
  ]}
  steps={[
    'Sag mir, wann du die Ersatz-PA brauchst und wie groß der Raum ist.',
    'Ich stelle PA, Licht, Mikrofon und Nebelmaschine passend zusammen.',
    'Bring deinen DJ-Mixer und deine Kopfhörer mit – den Rest prüfe ich mit dir vor der Abfahrt.',
  ]}
  products={products}
  faqs={faqs}
  jsonLd={jsonLd}
  breadcrumbSegments={breadcrumbSegments}
  startingPrice={priceValue}
/>

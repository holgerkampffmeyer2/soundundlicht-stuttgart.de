---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
import TechnicalSpecs from '../../components/vermietung/TechnicalSpecs.astro';
import RentalIncludes from '../../components/vermietung/RentalIncludes.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import DecisionHelp from '../../components/vermietung/DecisionHelp.astro';
import RelatedLinks from '../../components/vermietung/RelatedLinks.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceArea } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'mini-party-beamer')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "Mini Party Beamer" }
];

const pageTitle = "Party Beamer mieten in Stuttgart | Sound & Licht Stuttgart";

const faqs = await getFaqsForPage('mini-party-beamer');

const images = [
  "/img/vermietung/beamer3.webp"
];

const siteUrl = "https://soundundlicht-stuttgart.de";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Mini Party Beamer Vermietung",
  "description": "Miete den Topvision T21 LED Beamer mit 7000 Lumen für Filme, Diashows und Präsentationen. HDMI, USB, VGA und kabelloses Streaming per EZCast.",
  "image": [
    siteUrl + images[0]
  ],
  "serviceType": "Veranstaltungstechnik-Vermietung",
  "areaServed": serviceArea,
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://soundundlicht-stuttgart.de/#business"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": product.priceValue,
      "priceCurrency": "EUR",
      "unitCode": "DAY"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://soundundlicht-stuttgart.de/"},
    {"@type": "ListItem", "position": 2, "name": "Vermietung", "item": "https://soundundlicht-stuttgart.de/vermietung"},
    {"@type": "ListItem", "position": 3, "name": "Mini Party Beamer", "item": "https://soundundlicht-stuttgart.de/vermietung/mini-party-beamer"}
  ]
};

const specs = {
  "Modell": "Topvision LED Projektor T21",
  "Helligkeit": "7000 Lumen",
  "Anschlüsse": "HDMI, USB, VGA",
  "Kabelloses Streaming": "EZCast App (vom Smartphone)",
  "Einsatz": "Filme, Diashows, Präsentationen",
  "Besonderheiten": "Kompakt, leicht & schnell aufgebaut"
};

const rentalIncludes = [
  "1x Topvision T21 LED Beamer",
  "1x Netzkabel",
  "1x HDMI-Kabel",
  "Einweisung bei der Abholung"
];

const events = [
  {
    title: "Hochzeit",
    description: "Zeige eure schönsten Fotos als Diashow oder überrasche das Brautpaar mit einem selbst gedrehten Film – der Beamer macht daraus einen Gänsehautmoment.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Firmenfeier",
    description: "Für Präsentationen, Jubiläumsvideos oder das Firmen-Rückblick-Kino sorgt der Beamer für ein großes, professionelles Bild.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Filmabend",
    description: "Ob Gartenkino, Fußball-Übertragung oder Spieleabend an der Wand: Mit 7000 Lumen holst du das Kino zu dir nach Hause.",
    personCount: "bis 30 Personen"
  }
];
---

<ProductLayout
  product={product}
  pageTitle={pageTitle}
  description="Miete den Topvision T21 LED Beamer mit 7000 Lumen für Filme, Diashows und Präsentationen. HDMI, USB, VGA und kabelloses Streaming per EZCast."
  image="/img/vermietung/beamer3.webp"
  preloadImage="/img/vermietung/beamer3.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Licht", label: "Topvision T21 Party Beamer" }}
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
  breadcrumbSegments={breadcrumbSegments}
>
  <!-- Hero -->
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/beamer3.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel & Einweisung
          </span>
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">Party Beamer mieten</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Der Topvision T21 LED Beamer projiziert mit 7000 Lumen gestochen scharfe Bilder auf Wand, Leinwand oder Gartenwand.
          Anschlüsse wie HDMI, USB und VGA sowie kabelloses Streaming per EZCast machen ihn zum flexiblen Allrounder für Filme, Diashows, Fußballübertragungen und Präsentationen.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Preis & Kaution -->
  <RentalPricing price={product.price} deposit={100} />

  <!-- 3. Technische Spezifikation -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Technische Daten</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Topvision T21 LED Beamer</h2>
      </div>
      <TechnicalSpecs specs={specs} />
    </div>
  </section>

  <!-- 4. Entscheidungshilfe -->
  <DecisionHelp
    heading="Wann brauchst du einen Party Beamer?"
    intro="Ein Beamer verwandelt jede freie Fläche in eine Leinwand – für Unterhaltung, Erinnerungen und Informationen."
    items={[
      { title: "Diashow & Erinnerungen", text: "Auf Hochzeiten und Geburtstagen laufen Fotos und Videos als Diashow – der Beamer macht den Moment für alle Gäste sichtbar." },
      { title: "Filmabend & Gartenkino", text: "Für Kino-Feeling unter freiem Himmel oder im Partyraum projiziert der Beamer Filme und Serien in großem Format." },
      { title: "Fußball & Live-Events", text: "Übertrage Sportereignisse oder Live-Streams auf eine große Fläche – ideal für Public Viewing in kleiner Runde." },
      { title: "Präsentationen", text: "Für Firmenfeiern, Vereine oder Schulungen zeigt der Beamer Präsentationen und Videos zuverlässig an." },
      { title: "Kabelloses Streaming", text: "Über die EZCast App spielst du Inhalte direkt vom Smartphone zu – ganz ohne Kabel." }
    ]}
  />

  <!-- 5. Lieferumfang -->
  <RentalIncludes items={rentalIncludes} />

  <!-- 6. Beispielanwendungen -->
  <ExampleEvents events={events} />

  <!-- 6b. Dazu passend -->
  <RelatedLinks
    items={[
      { title: "Max Party Bar", url: "/vermietung/max-party-bar", text: "Die passende Lichtanlage für stimmungsvolle Ambientebeleuchtung rund um den Beamer." },
      { title: "Powerstation", url: "/vermietung/powerstation", text: "Für Gartenkino ohne Steckdose: Die Powerstation versorgt Beamer und Ton zuverlässig." },
      { title: "JBL Partybox 300/320", url: "/vermietung/jbl-partybox-300-320", text: "Der passende Sound zum Bild – fürs Kino-Erlebnis mit kräftigem Ton." }
    ]}
  />

  <!-- FAQ -->
  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-play text-2xl md:text-3xl font-bold text-center mb-10">
        Häufig gestellte Fragen
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-details bg-[var(--color-surface)] rounded-xl p-4 cursor-pointer">
            <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
              <span class="faq-icon">
                <Icon name="chevron-right" class="w-3 h-3" />
              </span>
              {faq.question}
            </summary>
            <p class="text-[var(--color-text-muted)] mt-3 ml-9">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
      <p class="text-center mt-6">
        <a href="/faq" class="text-[var(--color-secondary)] hover:underline font-semibold">Alle Fragen zur Veranstaltungstechnik ansehen →</a>
      </p>
    </div>
  </section>
</ProductLayout>

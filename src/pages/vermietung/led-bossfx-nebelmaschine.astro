---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import TechnicalSpecs from '../../components/vermietung/TechnicalSpecs.astro';
import RentalIncludes from '../../components/vermietung/RentalIncludes.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import BrandBadges from '../../components/vermietung/BrandBadges.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceJsonLd, videoJsonLd, videoPublisherJsonLd, faqPageJsonLd, breadcrumbJsonLd } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'led-bossfx-nebelmaschine')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "LED BossFX & Nebelmaschine" }
];

const pageTitle = "LED BossFX-2 Pro & Nebelmaschine | Sound und Licht Stuttgart - Holger Kampffmeyer";

const faqs = getFaqsForPage('led-bossfx-nebelmaschine');

const images = [
  "/img/vermietung/LED-BossFX2-Pro-Nebel-AI.webp",
  "/img/vermietung/stairville-led-bossfx-2-pro-2.webp",
  "/img/vermietung/stairville-led-bossfx-2-pro-3.webp",
  "/img/vermietung/stairville-led-bossfx-2-pro-4.webp",
  "/img/vermietung/stairville-af-150-fog-machine-2.webp",
  "/img/vermietung/stairville-af-150-fog-machine-1.webp"
];










const specsPartylicht = {
  "Modell": "Stairville LED BossFX-2 Pro",
  "Effekte": "2 Derbys, 2 LED Flood Panels, 4 Strobe-LEDs",
  "Steuerung": "Sound-zu-Licht, Fernbedienung",
  "Stativ": "inklusive",
  "Besonderheiten": "Weißes UV und Strobe kombiniert"
};

const specsNebelmaschine = {
  "Modell": "Stairville AF-150 DMX",
  "Leistung": "800 W",
  "Ausstoß": "ca. 110 m³/min",
  "Fluid": "1L inklusive",
  "Steuerung": "DMX, Fernbedienung"
};

const rentalIncludes = [
  "1x Stairville LED BossFX-2 Pro Lichtanlage",
  "1x Stairville AF-150 Nebelmaschine",
  "1x Stativ",
  "1x Fernbedienung",
  "1L Nebelfluid"
];

const events = [
  {
    title: "Geburtstagsfeier",
    description: "Die Kombination aus Licht und Nebel sorgt für eine top Party-Atmosphäre. Perfekt für Geburtstagsfeiern und private Feiern.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Hochzeit",
    description: "Verleih deiner Hochzeit das gewisse Extra mit beeindruckender Lichtshow und Nebeleffekten.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Firmenfeier",
    description: "Professionelle Beleuchtung für Firmenfeiern und Events. Die Lichteffekte kommen durch den Nebel besonders gut zur Geltung.",
    personCount: "bis 100 Personen"
  }
];

const serviceJsonLdData = JSON.parse(JSON.stringify(serviceJsonLd(product, images)));
const breadcrumbJsonLdData = JSON.parse(JSON.stringify(breadcrumbJsonLd(breadcrumbSegments)));
const faqPageJsonLdData = JSON.parse(JSON.stringify(faqPageJsonLd(faqs)));
const videoJsonLdData = JSON.parse(JSON.stringify(videoJsonLd(
  "MzCgO9gkBzQ",
  "LED BossFX & Nebelmaschine Demo",
  "Demo der LED BossFX-2 Pro Partylichtanlage mit AF-150 Nebelmaschine in Aktion",
  "/img/vermietung/LED-BossFX2-Pro-Nebel-AI.webp",
  videoPublisherJsonLd
)));
---

<ProductLayout 
  product={product}
  pageTitle={pageTitle}
  description="Miete die LED Party-Lichtanlage BossFX-2 Pro mit AF-150 Nebelmaschine. Sound-zu-Licht Modus und DMX-Steuerung für deine Party."
  image="/img/vermietung/LED-BossFX2-Pro-Nebel-AI.webp"
  preloadImage="/img/vermietung/LED-BossFX2-Pro-Nebel-AI.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Licht", label: "Lichtanlage LED BossFX-2 Pro und AF-150 Fog Machine" }}
  galleryImages={images}
  jsonLd={[serviceJsonLdData, breadcrumbJsonLdData, faqPageJsonLdData, videoJsonLdData]}
  breadcrumbSegments={breadcrumbSegments}
>
  <!-- Header -->
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/LED-BossFX2-Pro-Nebel-AI.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <Icon name="check" class="w-3.5 h-3.5" />
            Inkl. Kabel & Einweisung
          </span>
          <BrandBadges brands={product.brands} />
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">LED BossFX-2 Pro & Nebelmaschine</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Die Stairville LED BossFX-2 Pro ist eine komplette Party-Lichtanlage für DJs und Events: mit 2 Derby-Beams, 2 hellen Flood-Panels, 4 Strobe-LEDs (Weiß/UV) und schnellem Plug-and-Play-Aufbau inklusive Stativ.
          <br />
           Erhältlich auch als Set mit leistungsstarker 800W Nebelmaschine. Unerlässlich, um die Lichteffekte richtig zur Geltung zu bringen!
        </p>
      </div>
    </div>
  </section>

  <!-- Demo Video -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Video</span>
        <h2 class="font-play text-3xl font-bold mt-2">Light-Demo</h2>
        <p class="text-[var(--color-text-muted)] mt-2">Eindruck der LED BossFX-2 Pro in Aktion</p>
      </div>
       <div class="aspect-video rounded-xl overflow-hidden bg-[var(--color-bg)]">
        <iframe 
          src="https://www.youtube-nocookie.com/embed/MzCgO9gkBzQ" 
          title="LED BossFX Demo"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 2. Preis & Kaution -->
  <RentalPricing price={product.price} deposit={100} />

  <!-- 3a. Technische Spezifikation Partylicht -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Technische Daten</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">LED BossFX-2 Pro</h2>
      </div>
      <TechnicalSpecs specs={specsPartylicht} />
    </div>
  </section>

  <!-- 3b. Technische Spezifikation Nebelmaschine -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">AF-150 Nebelmaschine</h2>
      </div>
      <TechnicalSpecs specs={specsNebelmaschine} />
      <p class="text-center text-[var(--color-text-muted)] mt-8">
        Nebelmaschinen gibt es auch einzeln: Schau dir meine <a href="/vermietung/nebelmaschinen" class="text-[var(--color-secondary)] hover:underline">Nebelmaschinen</a> an – die kompakte AF-150 und die stärkere Uking 1200W.
      </p>
    </div>
  </section>

   <!-- 4. Lieferumfang -->
   <RentalIncludes items={rentalIncludes} />

   <!-- 5. Beispielanwendungen -->
   <ExampleEvents events={events} />

   <!-- FAQ -->
   <FAQSection faqs={faqs} />
</ProductLayout>



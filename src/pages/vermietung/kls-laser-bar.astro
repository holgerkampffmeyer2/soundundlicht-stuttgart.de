---
import ProductLayout from '../../components/vermietung/ProductLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import TechnicalSpecs from '../../components/vermietung/TechnicalSpecs.astro';
import RentalIncludes from '../../components/vermietung/RentalIncludes.astro';
import RentalPricing from '../../components/vermietung/RentalPricing.astro';
import ExampleEvents from '../../components/vermietung/ExampleEvents.astro';
import BrandBadges from '../../components/vermietung/BrandBadges.astro';
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../../lib/faqUtils';
import { serviceJsonLd, videoJsonLd, videoPublisherJsonLd, faqPageJsonLd, breadcrumbJsonLd } from '../../data/jsonLd';

const products = await getCollection('products');
const product = products.find(i => i.data.slug === 'kls-laser-bar')!.data;

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Vermietung", href: "/vermietung" },
  { label: "KLS Laser Bar" }
];

const pageTitle = "Eurolite KLS Laser Bar & Nebelmaschine | Sound und Licht Stuttgart";

const faqs = getFaqsForPage('kls-laser-bar');

const images = [
  "/img/vermietung/kls-laserbar-ai.webp",
  "/img/vermietung/eurolite-kls-laser-bar2.webp",
  "/img/vermietung/IMG_6642.webp",
  "/img/vermietung/uking_fogger-1200.webp"
];










const specsLaserBar = {
  "Modell": "Eurolite KLS Laser Bar FX",
  "Effekte": "2 Derbys, 2 LED Spots, 4 weiße Strobe-LEDs",
  "Laser": "RG, 2M",
  "Steuerung": "Sound-zu-Licht, Fernbedienung",
  "Stativ": "inklusive",
  "Besonderheiten": "Kein Laserschutzbeauftragter notwendig"
};

const specsNebelmaschine = {
  "Modell": "Nebelmaschine 1200W",
  "Leistung": "1200 W",
  "Ausstoß": "ca. 110 m³/min",
  "Fluid": "1L inklusive",
  "Steuerung": "Fernbedienung"
};

const rentalIncludes = [
  "1x Eurolite KLS Laser Bar FX",
  "1x Nebelmaschine 1200W (optional)",
  "1x Stativ",
  "1x Fernbedienung",
  "1L Nebelfluid (bei Nebelmaschine)"
];

const events = [
  {
    title: "Geburtstagsfeier",
    description: "Die Kombination aus Laser-Effekten und Nebel sorgt für eine tolle Party-Atmosphäre. Perfekt für Geburtstagsfeiern.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Hochzeit",
    description: "Verleih deiner Hochzeit das gewisse Extra mit spektakulären Laser-Show-Effekten.",
    personCount: "bis 100 Personen"
  },
  {
    title: "Firmenfeier",
    description: "Professionelle Laserlichtanlage für Firmenfeiern und Events. Kein Laserschutzbeauftragter erforderlich.",
    personCount: "bis 100 Personen"
  }
];

const serviceJsonLdData = JSON.parse(JSON.stringify(serviceJsonLd(product, images)));
const breadcrumbJsonLdData = JSON.parse(JSON.stringify(breadcrumbJsonLd(breadcrumbSegments)));
const faqPageJsonLdData = JSON.parse(JSON.stringify(faqPageJsonLd(faqs)));
const videoJsonLdData = JSON.parse(JSON.stringify(videoJsonLd(
  "namuAf4RySA",
  "KLS Laser Bar & Nebelmaschine Demo",
  "Demo der Eurolite KLS Laser Bar FX mit 1200W Nebelmaschine - Laser-Effekte und Nebel in Aktion",
  "/img/vermietung/kls-laserbar-ai.webp",
  videoPublisherJsonLd
)));
---

<ProductLayout 
  product={product}
  pageTitle={pageTitle}
  description="Miete die Eurolite KLS Laser Bar FX mit 1200W Nebelmaschine. Sound-zu-Licht Steuerung für deine Party."
  image="/img/vermietung/kls-laserbar-ai.webp"
  preloadImage="/img/vermietung/kls-laserbar-ai.webp"
  pagefindType="produkt"
  pagefindMeta={{ price: product.price, image: images[0], category: "Licht", label: "Eurolite KLS Laser Bar" }}
  galleryImages={images}
  jsonLd={[serviceJsonLdData, breadcrumbJsonLdData, faqPageJsonLdData, videoJsonLdData]}
  breadcrumbSegments={breadcrumbSegments}
>
  <!-- Hero -->
  <section slot="hero" class="relative min-h-[60vh] flex items-center overflow-hidden">
    <img src="/img/vermietung/kls-laserbar-ai.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero-overlay-accent"></div>
    <div class="relative z-10 w-full py-32 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Vermietung</span>
        <div class="flex flex-wrap gap-3 mt-3 mb-2">
          <span class="price-badge">{product.price}</span>
          <span class="plug-badge-inline">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Inkl. Kabel & Einweisung
          </span>
          <BrandBadges brands={product.brands} />
        </div>
        <h1 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-4 gradient-text">Eurolite KLS Laser Bar FX</h1>
        <p class="text-[var(--color-text)] text-xl max-w-2xl">
          Die EUROLITE LED KLS Laser Bar FX ist ein kompaktes 4in1-Lichtset mit vielen Einsatzmöglichkeiten: mit 2 Derbys, 2 LED Spots, 4 weißen Strobe-LEDs und Laser (RG, 2M) sorgt die Lichtanlage für eine beeindruckende Lichtshow.
          Optional mit 1200W Nebelmaschine. Kein Laserschutzbeauftragter notwendig!
        </p>
      </div>
    </div>
  </section>

  <!-- Demo Video -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Video</span>
        <h2 class="font-play text-3xl font-bold mt-2">Light-Demo</h2>
        <p class="text-[var(--color-text-muted)] mt-2">Eindruck der Eurolite KLS Laser Bar in Aktion</p>
      </div>
       <div class="aspect-video rounded-xl overflow-hidden bg-[var(--color-bg)]">
        <iframe 
          src="https://www.youtube-nocookie.com/embed/namuAf4RySA" 
          title="KLS Laser Bar Demo"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 2. Preis & Kaution -->
  <RentalPricing price={product.price} deposit={100} />

  <!-- 3a. Technische Spezifikation Laser Bar -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Technische Daten</span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Eurolite KLS Laser Bar FX</h2>
      </div>
      <TechnicalSpecs specs={specsLaserBar} />
    </div>
  </section>

  <!-- 3b. Technische Spezifikation Nebelmaschine -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4">Nebelmaschine 1200W</h2>
      </div>
      <TechnicalSpecs specs={specsNebelmaschine} />
      <p class="text-center text-[var(--color-text-muted)] mt-8">
        Die 1200W Nebelmaschine kannst du auch einzeln mieten: <a href="/vermietung/nebelmaschinen#nebel-maschine" class="text-[var(--color-secondary)] hover:underline">Nebelmaschinen ansehen</a>.
      </p>
    </div>
  </section>

  <!-- 4. Lieferumfang -->
  <RentalIncludes items={rentalIncludes} />

  <!-- 5. Beispielanwendungen -->
  <ExampleEvents events={events} />

  <!-- FAQ -->
  <section class="section-padding">
    <div class="max-w-4xl mx-auto px-4">
      <FAQSection faqs={faqs} tone="licht" />
    </div>
  </section>
</ProductLayout>


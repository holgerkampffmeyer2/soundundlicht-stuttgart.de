---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CityHero from "../components/CityHero.astro";
import CityPackages from "../components/CityPackages.astro";
import CitySteps from "../components/CitySteps.astro";
import CityAreas from "../components/CityAreas.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContactSection from "../components/ContactSection.astro";
import FAQSection from "../components/FAQSection.astro";
import CityEinzeltechnik from "../components/CityEinzeltechnik.astro";
import { getCollection } from 'astro:content';
import { getFaqsForPage } from '../lib/faqUtils';
import citiesData from '../data/cities.json';

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "Fellbach" }
];

const cityFaqs = await getFaqsForPage('fellbach');
const allProducts = await getCollection('products');
const productsBySlug = Object.fromEntries(allProducts.map(p => [p.data.slug, p.data]));
const cityData = citiesData.find(c => c.slug === 'fellbach');
const einzelItems = (cityData?.einzelItems ?? [])
  .slice(0, 3)
  .map(slug => productsBySlug[slug])
  .filter(Boolean);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": cityFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const cityJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Veranstaltungstechnik Vermietung Fellbach",
  "description": "PA-Anlagen, Partyboxen und Lichttechnik mieten in Fellbach und Umgebung. Komplettpakete für Geburtstage, Hochzeiten und Vereinsfeiern. Abholung in Leinfelden-Echterdingen, nur 20 km.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://soundundlicht-stuttgart.de/#business"
  },
  "url": "https://soundundlicht-stuttgart.de/fellbach",
  "areaServed": {
    "@type": "City",
    "name": "Fellbach"
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Startseite",
      "item": "https://soundundlicht-stuttgart.de/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Fellbach",
      "item": "https://soundundlicht-stuttgart.de/fellbach"
    }
  ]
};
---

<Layout
  title="PA-Anlage & Partybox mieten in Fellbach | Sound & Licht Stuttgart"
  description="PA-Anlagen, Partyboxen und Lichttechnik mieten in Fellbach und Umgebung. Komplettpakete für Geburtstage, Hochzeiten und Vereinsfeiern. Abholung in Leinfelden-Echterdingen, nur 20 km."
  image="/img/header.webp"
  jsonLd={[breadcrumbJsonLd, cityJsonLd, faqJsonLd]}
>
  <Navbar currentPage="city" />

  <Breadcrumb segments={breadcrumbSegments} />

  <CityHero
    image="/img/cities/fellbach.webp"
    city="Fellbach"
    title="PA-Anlage & Partybox mieten in Fellbach"
    description="Du wohnst in Fellbach, Schmiden oder Oeffingen und brauchst eine Soundanlage oder Lichttechnik für deine Feier? Ich bin dein Verleiher im Großraum Stuttgart."
    details="Mein Standort in Leinfelden-Echterdingen ist nur ca. 20 km von Fellbach entfernt, gut erreichbar über die B14 und A8. Du kannst die Technik bequem abholen, ich helfe dir beim Einladen und erkläre dir den Aufbau. Anders als bei Versandverleihern kannst du die Technik vor der Abholung in Funktion sehen und bekommst eine persönliche Einweisung – so weißt du genau, was dich erwartet."
  />

  <CityPackages />
  {einzelItems.length > 0 && (
    <CityEinzeltechnik
      cityName="Fellbach"
      items={einzelItems}
      title={cityData?.einzelTitle}
      description={cityData?.einzelDescription}
    />
  )}
  <CitySteps />

  <CityAreas
    areas={cityData?.areas ?? []}
    intro="Auch aus Schmiden, Oeffingen, Weinstadt, Kernen im Remstal oder Waiblingen kommst du über die B14 und A8 zu mir – die Abholung in Leinfelden-Echterdingen ist in ca. 20–30 Minuten erreichbar."
  />

  <!-- FAQ -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto">
      <FAQSection faqs={cityFaqs} />
    </div>
  </section>

  <ContactSection
    title="Technik mieten in Fellbach – einfach anfragen"
    description="Du wohnst in Fellbach oder der Umgebung und brauchst Technik? Schreib mir eine E-Mail – die Abholung ist nur 20 km entfernt in Leinfelden-Echterdingen, Magellanstraße 4, verkehrsgünstig an A8 / B27. Ich melde mich innerhalb von 12 Stunden bei dir!"
    distanceText="Nur ca. 20 km von Fellbach"
  />

  <Footer />
</Layout>
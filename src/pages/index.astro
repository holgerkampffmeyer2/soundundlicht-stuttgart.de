---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactSection from "../components/ContactSection.astro";
import CityGrid from "../components/CityGrid.astro";
import FAQSection from "../components/FAQSection.astro";
import { getFaqsForPage } from '../lib/faqUtils';
import { getCollection } from 'astro:content';
import { serviceArea, offerCatalogJsonLd } from '../data/jsonLd';
import HeroSlider from "../components/HeroSlider.astro";
import BieteSection from "../components/BieteSection.astro";
import PackageCardGrid from '../components/PackageCardGrid.astro';
import StickyMerkliste from '../components/StickyMerkliste.astro';
import CitySteps from '../components/CitySteps.astro';

const products = await getCollection('products');
const rentalItems = products.map(i => i.data);
const indexFaqs = await getFaqsForPage('index');

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": indexFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const komplettPakete = rentalItems.filter(i => i.category === 'Paket');

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Veranstaltungstechnik Vermietung",
  "description": "Verleih von PA-Anlagen, Partyboxen, Lichttechnik und DJ-Equipment in Stuttgart und Umgebung",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://soundundlicht-stuttgart.de/#business"
  },
  "areaServed": serviceArea
};
---

<Layout
  title="Partytechnik mieten Stuttgart | Sound & Licht Verleih - Leinfelden-Echterdingen, Esslingen, Tübingen"
  description="Vermietung von PA-Anlagen, Partyboxen & Lichttechnik in Stuttgart, Leinfelden-Echterdingen, Esslingen, Tübingen. Ab 160€ pro Tag. DJ-Service, persönliche Beratung, einfache Abholung."
  image="/img/slider/slide1.webp"

  jsonLd={[serviceJsonLd, faqJsonLd, offerCatalogJsonLd(rentalItems)]}
>
  <Navbar currentPage="home" />

  <div class="relative">
    <HeroSlider
      id="home"
      slides={[
        {
          title: "Sound & Licht für deine Feier",
          titleTag: "h1",
          description: "Lautsprecher, Partylicht und Mikrofon – einfach abholen und losfeiern. Musik per Spotify vom Handy, einfacher Aufbau, inkl. Einweisung. Für Feiern mit 30 bis 150 Personen in Stuttgart und Umgebung.",
          category: "Lokaler Verleih: Abholung in Leinfelden-Echterdingen",
          buttons: [
            { text: "Paket finden", href: "/vermietung#pakete", class: "btn-primary" },
            { text: "Verfügbarkeit prüfen", href: "/vermietung#kontakt", class: "btn-secondary" }
          ]
        },
        {
          title: "Komplettpakete für Hochzeiten & Firmenfeiern",
          titleTag: "h2",
          description: "Sound, Licht und Effekte als fertiges Set – von der kleinen Feier bis zum großen Event. Alles Plug & Play, inklusive aller Kabel und persönlicher Einweisung.",
          category: "Rundum-sorglos mieten",
          categoryColor: "var(--color-accent)",
          buttons: [
            { text: "Pakete ansehen", href: "/vermietung#pakete", class: "btn-primary" },
            { text: "Verfügbarkeit prüfen", href: "/vermietung#kontakt", class: "btn-secondary" }
          ]
        },
        {
          title: "DJ-Equipment & PA-Anlagen",
          titleTag: "h2",
          description: "Professioneller Sound mit Säulensystemen, Mischpulten und Moving Heads. Für DJs und anspruchsvolle Events mit bis zu 150 Personen.",
          category: "Für Profis & DJs",
          categoryColor: "var(--color-accent)",
          buttons: [
            { text: "Equipment ansehen", href: "/vermietung#sound", class: "btn-primary" },
            { text: "Jetzt anfragen", href: "/vermietung#kontakt", class: "btn-secondary" }
          ]
        },
        {
          title: "Musik vom Handy? Kein Problem.",
          titleTag: "h2",
          description: "Spotify, Apple Music oder jeder andere Player – einfach per Bluetooth verbinden und loslegen. Kein DJ, kein Mischpult nötig. Ich zeige dir bei der Abholung, wie es geht.",
          category: "Plug & Play – kein Technikwissen nötig",
          categoryColor: "var(--color-accent)",
          buttons: [
            { text: "Paket finden", href: "/vermietung#pakete", class: "btn-primary" },
            { text: "Jetzt anfragen", href: "/vermietung#kontakt", class: "btn-secondary" }
          ]
        }
      ]}
    >
      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-float z-20">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--color-text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </HeroSlider>

  </div>

  <!-- Services Section -->
  <section id="services" class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          Meine Leistungen
        </span>
        <h2 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-6">
          Was ich dir biete
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-3xl mx-auto">
          Professionelle Veranstaltungstechnik, Partyboxen und Lichttechnik für deine Feier in Stuttgart, Leinfelden-Echterdingen, Esslingen, Tübingen, Kornwestheim und Umgebung. Egal ob Geburtstag, Hochzeit, Vereinsfeier oder Firmenfeier – ich habe die passende Technik für unvergessliche Events. Einfach mieten, abholen und losfeiern!
        </p>
      </div>

      <BieteSection />

      <div class="text-center mt-12 animate-on-scroll">
        <a href="/vermietung" class="btn-primary">
          Pakete ansehen &amp; anfragen ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Pakete Section -->
  <section id="pakete" class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          Pakete
        </span>
        <h2 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-6">
          Meine Komplettpakete
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-3xl mx-auto">
          Alles aus einer Hand – Sound, Licht und Effekte als fertiges Paket. Plug &amp; Play, inklusive Kabel und Einweisung.
        </p>
      </div>

      <PackageCardGrid pakete={komplettPakete} />

      <div class="text-center mt-6 animate-on-scroll">
        <p class="text-[var(--color-text-muted)] text-sm">
          Du brauchst nur Lautsprecher oder nur Licht? <a href="/vermietung#sound" class="text-[var(--color-secondary)] hover:underline">Auch Einzelgeräte sind einzeln mietbar</a>.
        </p>
      </div>

      <div class="text-center mt-12 animate-on-scroll">
        <a href="/vermietung" class="btn-secondary">
          Alle Pakete ansehen ↗
        </a>
      </div>
    </div>
  </section>

  <!-- So einfach geht's: Zweispaltig -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <!-- Linke Spalte: Musik vom Handy -->
      <div class="animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          Plug &amp; Play
        </span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4 mb-4">
          Musik vom Handy? Kein Problem.
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg mb-6">
          Spotify, Apple Music oder jeder andere Player – einfach per Bluetooth verbinden und loslegen. Kein DJ, kein Mischpult nötig. Ich zeige dir bei der Abholung, wie es geht.
        </p>
        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5">
          <p class="text-[var(--color-text)] text-sm mb-3 font-semibold">Tipp für deine Feier:</p>
          <ul class="text-[var(--color-text-muted)] text-sm space-y-2">
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-secondary)] mt-0.5">✓</span>
              Playliste vor der Feier offline herunterladen
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-secondary)] mt-0.5">✓</span>
              Handy auf „Nicht stören", während die Musik läuft
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-secondary)] mt-0.5">✓</span>
              Handy vor der Party vollständig aufladen
            </li>
          </ul>
        </div>
      </div>

      <!-- Rechte Spalte: Für Einsteiger -->
      <div class="animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          Das erste Mal Technik mieten?
        </span>
        <h2 class="font-play text-3xl md:text-4xl font-bold mt-4 mb-4">
          So einfach geht's.
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg mb-6">
          Keine Vorkenntnisse nötig. Alles ist Plug &amp; Play – ich erkläre dir bei der Abholung alles, was du wissen musst.
        </p>
        <ul class="text-[var(--color-text-muted)] grid grid-cols-1 gap-3">
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Musik per Spotify vom Handy
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Aufbau in wenigen Minuten
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Einweisung inklusive
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Alle Kabel dabei
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Technik vorher ansehen &amp; testen
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Normales Auto reicht
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">✓</span> Abholung in Leinfelden-Echterdingen
          </li>
        </ul>
        <a href="#kontakt" class="btn-primary inline-block mt-6">
          Jetzt unverbindlich anfragen ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Einzelgeräte: Auch einzeln mietbar -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
          Einzelgeräte
        </span>
        <h2 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-6">
          Auch einzeln mietbar
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-3xl mx-auto">
          Du brauchst nur Lautsprecher oder nur Licht? Kein Problem – alle Geräte sind auch einzeln verfügbar.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/vermietung#sound" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M9 10a1 1 0 011-1h1a1 1 0 011 1v4a1 1 0 01-1 1h-1a1 1 0 01-1-1v-4z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">JBL Partyboxen</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 80€ / Tag</p>
        </a>

        <a href="/vermietung#sound" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">Säulensystem</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 120€ / Tag</p>
        </a>

        <a href="/vermietung#licht" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">Moving Heads</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 50€ / Tag</p>
        </a>

        <a href="/vermietung#licht" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">LED Par & Party Bar</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 20€ / Tag</p>
        </a>

        <a href="/vermietung#sound" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">Mikrofon</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 10€ / Tag</p>
        </a>

        <a href="/vermietung#sound" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">Mischpult</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 15€ / Tag</p>
        </a>

        <a href="/vermietung#licht" class="group bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:border-[var(--color-secondary)] transition-all duration-200 cursor-pointer animate-on-scroll">
          <div class="text-[var(--color-secondary)] mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
            </svg>
          </div>
          <h3 class="font-play text-lg font-bold group-hover:text-[var(--color-secondary)] transition-colors duration-200">Nebelmaschine</h3>
          <p class="text-[var(--color-text-muted)] text-sm mt-1">ab 20€ / Tag</p>
        </a>

        <div class="flex items-center justify-center animate-on-scroll">
          <a href="/vermietung" class="text-[var(--color-secondary)] hover:text-[var(--color-text)] font-semibold transition-colors duration-200 text-center">
            Alle Geräte ansehen →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- So funktioniert's Section -->
  <CitySteps />

  <!-- Testimonials Section -->
  <Testimonials id="bewertungen" />

  <!-- City Grid Section -->
  <CityGrid />

  <!-- FAQ Section -->
  <section id="faq" class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto">
      <FAQSection faqs={indexFaqs} />
    </div>
  </section>

  <!-- DJ Section -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto text-center animate-on-scroll">
      <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">
        DJ Buchen
      </span>
      <h2 class="font-play text-4xl md:text-5xl font-bold mt-4 mb-6">
        Du brauchst einen DJ?
      </h2>
      <p class="text-[var(--color-text-muted)] text-lg mb-8 max-w-3xl mx-auto">
        Ich bin nicht nur dein Ansprechpartner für Veranstaltungstechnik, sondern auch als DJ Hulk auf Hochzeiten, Firmenfeiern und Club-Events unterwegs. House, Tech House, Deep House – ich bringe die Menge zum Tanzen. Musikwünsche werden vorab besprochen und berücksichtigt.
      </p>
      <a href="https://holger-kampffmeyer.de/djhulk-electronic-music/" target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        DJ Hulk kennenlernen ↗
      </a>
    </div>
  </section>

  <ContactSection
    title="Verfügbarkeit prüfen"
    description="Du hast Fragen oder möchtest Technik für deine Feier mieten? Schreib uns oder ruf an! Abholung und persönliche Beratung in Leinfelden-Echterdingen. Ich melde mich innerhalb von 12 Stunden."
    addressLocality="Echterdingen"
    addressNote="(Großraum Stuttgart)"
    addressLabel="Adresse"
    secondaryButtonText="Unverbindliche Anfrage ↗"
  />

  <StickyMerkliste href="/vermietung#kontakt" />

  <!-- Footer -->
  <Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import faqsData from "../data/faqs.json";
import citiesData from "../data/cities.json";
import type { FaqEntry } from "../lib/faqUtils";
import { faqPageJsonLd } from "../data/jsonLd";

const PACKAGES = [
  "partypaket-stuttgart",
  "veranstaltungspaket-stuttgart",
  "djpaket-fildern",
  "akku-party-paket",
  "karaoke-paket",
];
const SOUND = ["jbl-partybox-300-320", "ld-maui-28g3", "mikrofon-mischpult"];
const LIGHT = [
  "kls-laser-bar",
  "led-bossfx-nebelmaschine",
  "partylicht-moving-head",
  "led-scheinwerfer",
  "nebelmaschinen",
  "max-party-bar",
  "mini-party-beamer",
  "powerstation",
];
const CITY_SLUGS = citiesData.map((c) => c.slug);

const faqs: FaqEntry[] = faqsData;

function categoryOf(faq: FaqEntry): string {
  const pages = faq.pages ?? [];
  const has = (list: string[]) => pages.some((p) => list.includes(p));
  if (pages.includes("index")) return "allgemein";
  if (pages.includes("vermietung")) return "katalog";
  if (has(PACKAGES)) return "pakete";
  if (has(SOUND)) return "sound";
  if (has(LIGHT)) return "licht";
  if (has(CITY_SLUGS)) return "cities";
  return "sonstiges";
}

const grouped: Record<string, FaqEntry[]> = {};
for (const faq of faqs) {
  const cat = categoryOf(faq);
  (grouped[cat] ??= []).push(faq);
}

const SECTIONS = [
  { id: "allgemein", title: "Allgemein & Buchung", icon: "info" },
  { id: "pakete", title: "Komplettpakete", icon: "package" },
  { id: "sound", title: "Sound & PA-Anlagen", icon: "volume-up" },
  { id: "licht", title: "Licht & Effekte", icon: "light-bulb" },
  { id: "sonstiges", title: "Weitere Fragen", icon: "chat" },
];
const sections = SECTIONS.filter((s) => grouped[s.id]?.length);

const primaryCityOf = (faq: FaqEntry): string | undefined =>
  CITY_SLUGS.find((slug) => (faq.pages ?? []).includes(slug));

const cityGroups = citiesData
  .map((city) => ({
    slug: city.slug,
    name: city.name,
    items: (grouped.cities ?? []).filter(
      (faq) => primaryCityOf(faq) === city.slug
    ),
  }))
  .filter((group) => group.items.length > 0);

const cityCount = grouped.cities?.length ?? 0;
const toc = [
  ...sections,
  ...(cityCount
    ? [{ id: "standorte", title: "Standorte & Lieferung", icon: "map-pin" }]
    : []),
];
---

<Layout
  title="FAQ – Alle häufigen Fragen zur Veranstaltungstechnik mieten | Sound & Licht Stuttgart"
  description="Alle Antworten zur Veranstaltungstechnik-Vermietung: Preise, Buchung, Sound, Licht, Komplettpakete sowie Anlieferung & Abholung in Stuttgart und Umgebung."
  jsonLd={[faqPageJsonLd(faqs)]}
>
  <Navbar currentPage="/faq" />

  <div class="faq-page">
    <section class="faq-hero hero-gradient pt-40 pb-20 md:pt-48 md:pb-24 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <span class="faq-eyebrow">
          <Icon name="chat" />
          {faqs.length} Fragen &amp; Antworten
        </span>
        <h1 class="font-play text-5xl md:text-7xl mb-6 gradient-text">FAQ</h1>
        <p class="faq-subtitle text-xl md:text-2xl max-w-2xl mx-auto">
          Alle häufigen Fragen zur Veranstaltungstechnik-Vermietung
        </p>
      </div>
    </section>

    <section class="faq-toc-section section-padding">
      <div class="max-w-4xl mx-auto">
        <h2 class="sr-only">Themenübersicht</h2>
        <nav class="toc mb-12 animate-on-scroll" aria-label="Inhaltsverzeichnis">
          <ul class="toc-list">
            {toc.map((section) => (
              <li>
                <a href={`#${section.id}`} class="toc-chip" data-tone={section.id}>
                  <Icon name={section.icon} />
                  {section.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {sections.map((section) => {
          const items = grouped[section.id];
          if (!items?.length) return null;
          return (
            <section id={section.id} class="faq-section mb-16 animate-on-scroll" data-topic={section.id}>
              <div class="faq-section-head">
                <span class="faq-section-icon">
                  <Icon name={section.icon} />
                </span>
                <div>
                  <h2 class="font-play text-3xl">{section.title}</h2>
                  <span class="faq-section-meta">{items.length} Fragen</span>
                </div>
              </div>
              <div class="space-y-4">
                {items.map((faq) => (
                  <details class="faq-item">
                    <summary>
                      <span class="faq-question-icon">
                        <Icon name={section.icon} />
                      </span>
                      <span class="flex-1">{faq.question}</span>
                      <Icon name="chevron-down" class="faq-chevron" />
                    </summary>
                    <div class="faq-answer">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          );
        })}

        {cityCount > 0 && (
          <section id="standorte" class="faq-section animate-on-scroll" data-topic="standorte">
            <div class="faq-section-head">
              <span class="faq-section-icon">
                <Icon name="map-pin" />
              </span>
              <div>
                <h2 class="font-play text-3xl">Standorte &amp; Lieferung</h2>
                <span class="faq-section-meta">{cityCount} Städte</span>
              </div>
            </div>
            <div class="space-y-4">
              {cityGroups.map((group) => (
                <details class="faq-item">
                  <summary>
                    <span class="faq-question-icon">
                      <Icon name="map-pin" />
                    </span>
                    <span class="flex-1">{group.name}</span>
                    <Icon name="chevron-down" class="faq-chevron" />
                  </summary>
                  <div class="faq-answer city-answers">
                    {group.items.map((faq) => (
                      <div class="city-answer">
                        <p class="city-question">{faq.question}</p>
                        <p>{faq.answer}</p>
                      </div>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  .faq-hero {
    position: relative;
    overflow: hidden;
  }

  .faq-hero > div {
    position: relative;
    z-index: 1;
  }

  .faq-hero::after {
    content: "";
    position: absolute;
    inset: auto 20% -35% 20%;
    height: 18rem;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-accent) 18%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .faq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .faq-eyebrow svg {
    width: 1rem;
    height: 1rem;
  }

  .faq-subtitle {
    color: color-mix(in srgb, var(--color-text) 85%, var(--color-text-muted));
  }

  .faq-toc-section {
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-bg));
    border-block: 1px solid var(--color-border);
  }

  .toc-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .toc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--faq-tone) 40%, var(--color-border));
    background: color-mix(in srgb, var(--faq-tone) 9%, var(--color-surface));
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .toc-chip svg {
    width: 1rem;
    height: 1rem;
    color: var(--faq-tone);
  }

  .toc-chip:hover {
    border-color: var(--faq-tone);
    background: color-mix(in srgb, var(--faq-tone) 18%, var(--color-surface));
    transform: translateY(-1px);
  }

  .toc-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 0.5rem;
  }

  .faq-section-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--faq-tone) 35%, transparent);
    background: color-mix(in srgb, var(--faq-tone) 15%, transparent);
    color: var(--faq-tone);
  }

  .faq-section-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .faq-section-meta {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-text-muted));
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-chip {
      transition: none;
    }
  }
</style>
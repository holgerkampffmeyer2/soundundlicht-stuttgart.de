---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const faqs = await getCollection("faqs");
const faqItems = faqs.map((f) => ({
  question: f.data.question,
  answer: f.data.answer,
}));

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<Layout
  title="FAQ – Häufige Fragen zur Veranstaltungstechnik mieten | Sound & Licht Stuttgart"
  description="Antworten zu Anlieferung, Aufbau, Abrechnung, Stornierung, Transport & Technikverleih in Stuttgart, Leinfelden-Echterdingen und Umgebung."
  jsonLd={[faqJsonLd]}
>
  <Navbar currentPage="/faq" />

  <section class="hero-gradient pt-40 pb-20 md:pt-48 md:pb-24 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-play text-5xl md:text-7xl font-bold mb-6 gradient-text">FAQ</h1>
      <p class="text-[var(--color-text-muted)] text-xl md:text-2xl max-w-2xl mx-auto">
        Häufige Fragen zur Veranstaltungstechnik-Vermietung
      </p>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto">
      <div class="bg-[var(--color-surface)] rounded-xl p-6 md:p-8">
        <div class="space-y-4">
          {faqItems.map((item) => (
            <details class="border border-[var(--color-surface-hover)] rounded-lg p-4">
              <summary class="font-semibold cursor-pointer text-lg">{item.question}</summary>
              <p class="mt-3 text-[var(--color-text-muted)] whitespace-pre-line leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

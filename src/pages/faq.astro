---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import faqsData from "../data/faqs.json";
import citiesData from "../data/cities.json";
import type { FaqEntry } from "../lib/faqUtils";
import { faqPageJsonLd } from "../data/jsonLd";

const PACKAGES = [
  "partypaket-stuttgart",
  "veranstaltungspaket-stuttgart",
  "djpaket-fildern",
  "akku-party-paket",
  "karaoke-paket",
];
const SOUND = ["jbl-partybox-300-320", "ld-maui-28g3", "mikrofon-mischpult"];
const LIGHT = [
  "kls-laser-bar",
  "led-bossfx-nebelmaschine",
  "partylicht-moving-head",
  "led-scheinwerfer",
  "nebelmaschinen",
  "max-party-bar",
  "mini-party-beamer",
  "powerstation",
];
const CITY_SLUGS = citiesData.map((c) => c.slug);
// const CITY_NAMES = new Map(citiesData.map((c) => [c.slug, c.name])); // unused

const faqs: FaqEntry[] = faqsData;

function categoryOf(faq: FaqEntry): string {
  const pages = faq.pages ?? [];
  const has = (list: string[]) => pages.some((p) => list.includes(p));
  if (pages.includes("index")) return "allgemein";
  if (pages.includes("vermietung")) return "katalog";
  if (has(PACKAGES)) return "pakete";
  if (has(SOUND)) return "sound";
  if (has(LIGHT)) return "licht";
  if (has(CITY_SLUGS)) return "cities";
  return "sonstiges";
}

const grouped: Record<string, FaqEntry[]> = {};
for (const faq of faqs) {
  const cat = categoryOf(faq);
  (grouped[cat] ??= []).push(faq);
}

const SECTIONS = [
  { id: "allgemein", title: "Allgemein & Buchung" },
  { id: "pakete", title: "Komplettpakete" },
  { id: "sound", title: "Sound & PA-Anlagen" },
  { id: "licht", title: "Licht & Effekte" },
  { id: "sonstiges", title: "Weitere Fragen" },
];
const sections = SECTIONS.filter((s) => grouped[s.id]?.length);

const primaryCityOf = (faq: FaqEntry): string | undefined =>
  CITY_SLUGS.find((slug) => (faq.pages ?? []).includes(slug));

const cityGroups = citiesData
  .map((city) => ({
    slug: city.slug,
    name: city.name,
    items: (grouped.cities ?? []).filter(
      (faq) => primaryCityOf(faq) === city.slug
    ),
  }))
  .filter((group) => group.items.length > 0);

const cityCount = grouped.cities?.length ?? 0;
const toc = [
  ...sections,
  ...(cityCount ? [{ id: "standorte", title: "Standorte & Lieferung" }] : []),
];
---

<Layout
  title="FAQ – Alle häufigen Fragen zur Veranstaltungstechnik mieten | Sound & Licht Stuttgart"
  description="Alle Antworten zur Veranstaltungstechnik-Vermietung: Preise, Buchung, Sound, Licht, Komplettpakete sowie Anlieferung & Abholung in Stuttgart und Umgebung."
  jsonLd={[faqPageJsonLd(faqs)]}
>
  <Navbar currentPage="/faq" />

  <!-- Hero -->
  <section class="hero-gradient pt-40 pb-20 md:pt-48 md:pb-24 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-play text-5xl md:text-7xl font-bold mb-6 gradient-text">FAQ</h1>
      <p class="text-[var(--color-text-muted)] text-xl md:text-2xl max-w-2xl mx-auto">
        Alle häufigen Fragen zur Veranstaltungstechnik-Vermietung
      </p>
    </div>
  </section>

  <!-- TOC -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-4xl mx-auto">
      <nav class="toc mb-12 animate-on-scroll" aria-label="Inhaltsverzeichnis">
        <ul class="flex flex-wrap gap-3 md:gap-4">
          {toc.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="inline-block px-4 py-2 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] text-sm font-medium hover:border-[var(--color-secondary)] hover:bg-[var(--color-bg)] transition-all duration-200"
              >
                {section.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {sections.map((section) => {
        const items = grouped[section.id];
        if (!items?.length) return null;
        return (
          <section id={section.id} class="mb-16 animate-on-scroll">
            <h2 class="font-play text-3xl font-bold mb-8 pb-3 border-b border-[var(--color-border)]">
              {section.title}
            </h2>
            <div class="space-y-4">
              {items.map((faq) => (
                <details class="faq-item bg-[var(--color-surface)] rounded-xl p-6 border border-[var(--color-border)]">
                  <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
                    <span class="text-[var(--color-secondary)]">?</span>
                    {faq.question}
                  </summary>
                  <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
                    <p class="text-[var(--color-text-muted)] leading-relaxed">{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        );
      })}

      {cityCount > 0 && (
        <section id="standorte" class="animate-on-scroll">
          <h2 class="font-play text-3xl font-bold mb-8 pb-3 border-b border-[var(--color-border)]">
            Standorte & Lieferung
          </h2>
          <div class="space-y-4">
            {cityGroups.map((group) => (
              <details class="faq-item bg-[var(--color-surface)] rounded-xl p-6 border border-[var(--color-border)]">
                <summary class="font-bold cursor-pointer flex items-center gap-3 list-none">
                  <span class="text-[var(--color-secondary)]">📍</span>
                  {group.name}
                </summary>
                <div class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-4">
                  {group.items.map((faq) => (
                    <div class="text-[var(--color-text-muted)] leading-relaxed">
                      <p class="font-semibold mb-1">{faq.question}</p>
                      <p>{faq.answer}</p>
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <Footer />
</Layout>